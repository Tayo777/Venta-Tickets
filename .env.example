# Copiá este archivo como ".env" y completá con tus datos reales.
# NUNCA subas el archivo ".env" a un repositorio (ya está en .gitignore).

# Credenciales de tu app "Marketplace" en Mercado Pago (Panel de desarrolladores > Tus apps).
MP_CLIENT_ID=
MP_CLIENT_SECRET=

PLATFORM_FEE_PCT=3
MP_FEE_ESTIMADA_PCT=6.39

# Envío de mails vía Brevo — https://app.brevo.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Venta de Entradas

# Tu mail: acá llegan los pedidos de aprobación de organizadores nuevos.
ADMIN_EMAIL=

# Tu usuario administrador. Se crea SOLO a partir de estas variables, la primera vez que
# arranca la app (nunca se escribe la contraseña en el código). Después de entrar la primera
# vez, cambiá la contraseña o al menos anotala en un lugar seguro — no en este archivo.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Clave larga y random para firmar las sesiones de login. Generá una vos (ej: cualquier
# cadena de 40+ caracteres al azar) y no la compartas.
SESSION_SECRET=

# API Key gratuita de https://api.imgbb.com/ (creá una cuenta, es gratis) — permite que los
# organizadores suban el flyer como imagen directamente, sin que vos hagas nada.
IMGBB_API_KEY=

# OPCIONAL. Ya no se usa para firmar QRs nuevos — ahora cada evento tiene su propio secreto
# (columna eventos.qr_secret, generado solo al crear el evento). Esta variable solo sirve si
# ya tenías eventos ANTES de este cambio: al arrancar, se la copia a esos eventos existentes
# para que sus QRs ya emitidos no dejen de funcionar de golpe. Si nunca tuviste esta variable
# antes, dejala vacía sin problema.
QR_SECRET=

# Secreto de webhooks de tu app en Mercado Pago (Panel de desarrolladores > Tu app > Webhooks
# > "Firma secreta"). Se usa para verificar que las notificaciones de pago realmente vienen
# de Mercado Pago y no de alguien simulando un pago aprobado.
MP_WEBHOOK_SECRET=

# Clave para firmar los JWT de login de la app móvil de guardias (endpoints /api/app/*).
# Generá una propia (40+ caracteres al azar) y no la compartas.
JWT_SECRET=

# URL pública donde va a vivir la app (sin barra al final), ej: https://tuapp.up.railway.app
BASE_URL=

PORT=3000
MYSQL_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SMTP para Nodemailer (OPCIONAL) ---
# Si cargás usuario y contraseña, los avisos al administrador salen por SMTP (Nodemailer).
# Si el envío falla o dejás esto vacío, salen igual por la API HTTP de Brevo (BREVO_API_KEY).
#
# OJO en Railway: bloquea/deja colgadas las conexiones SMTP salientes, que es justamente por lo
# que este proyecto usa la API de Brevo. Probá el envío después de deployar; si no llega nada
# por SMTP, dejá estas dos vacías y todo sigue funcionando por Brevo.
#
# Con Gmail hay que usar una "Contraseña de aplicación" (no la contraseña normal de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
