# Copiá este archivo como ".env" y completá con tus datos reales.
# NUNCA subas el archivo ".env" a un repositorio (ya está en .gitignore).

# Credenciales de tu app "Marketplace" en Mercado Pago (Panel de desarrolladores > Tus apps).
# NO es el Access Token de una cuenta personal: es el CLIENT_ID/SECRET de tu aplicación,
# necesarios para que cada organizador conecte SU PROPIA cuenta vía OAuth.
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Porcentaje que se queda la plataforma (vos) de cada venta.
PLATFORM_FEE_PCT=3
# Estimación automática de la comisión de Mercado Pago para calcular la tarifa que paga el
# comprador. Es una única estimación fija (no se le pregunta nada al organizador) — la
# comisión real depende del medio de pago que use cada comprador y se calcula recién
# después de cada venta (queda guardada para el informe del organizador).
MP_FEE_ESTIMADA_PCT=6.39

# Envío de mails vía Brevo (antes Sendinblue) — https://app.brevo.com
# API Key: Brevo > SMTP & API > API Keys > Generate a new API key
BREVO_API_KEY=
# Mail remitente: DEBE estar verificado en Brevo (Senders, Domains & Dedicated IPs > Senders)
BREVO_SENDER_EMAIL=
# Nombre que ve el comprador como remitente (opcional)
BREVO_SENDER_NAME=Venta de Entradas

# Clave que usa el celular del guardia para activarse (ej: /login-guardia?clave=TU_CLAVE)
GUARDIA_CLAVE=

# Clave para entrar al panel de admin general: /admin/eventos?clave=TU_CLAVE
ADMIN_CLAVE=

# URL pública donde va a vivir la app (sin barra al final), ej: https://tuapp.up.railway.app
BASE_URL=

# Puerto (Railway/Render lo asignan solos; dejalo vacío en producción)
PORT=3000

# Cadena de conexión a MySQL. En Railway: agregá el plugin "MySQL" al proyecto y
# referenciá la variable MYSQL_URL de ese servicio (no hace falta armarla a mano).
MYSQL_URL=

# Notificaciones de ventas e ingresos por Telegram (opcional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
