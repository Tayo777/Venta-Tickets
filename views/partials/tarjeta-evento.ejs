<a class="evento-row" href="/eventos/<%= evento.slug || evento.id %>">
    <img class="evento-row-thumb" src="<%= evento.flyer_url %>" alt="Flyer de <%= evento.nombre %>"
         loading="lazy" onerror="this.onerror=null; this.src='/flyer.png';">
    <div class="evento-row-info">
        <h3><%= evento.nombre %>
            <% if (finalizado) { %>
                <span class="badge finalizado">Finalizado · solo lectura</span>
            <% } else { %>
                <span class="badge <%= evento.conectado_mp ? 'activo' : 'sin-conectar' %>"><%= evento.conectado_mp ? 'Vendiendo' : 'Sin conectar MP' %></span>
            <% } %>
        </h3>
        <p><%= formatearFecha(evento.fecha) %><% if (evento.lugar_nombre) { %> · <%= evento.lugar_nombre %><% } %></p>
    </div>
</a>
