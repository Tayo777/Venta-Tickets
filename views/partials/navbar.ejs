<nav class="navbar">
    <a class="navbar-brand" href="/">
        <img src="/img/logo-placeholder.png" alt="Logo de TuEntradaYa" class="navbar-logo">
        <span>TuEntradaYa</span>
    </a>

    <!-- Búsqueda: navega al catálogo con el texto como query "q". El filtrado en /eventos
         todavía no lee ese parámetro — queda listo para engancharlo del lado del servidor
         sin tocar este formulario (mismo criterio que en landing.ejs). -->
    <form class="navbar-search" action="/eventos" method="GET" role="search">
        <input type="search" name="q" placeholder="Buscar eventos, artistas, ciudades..." aria-label="Buscar eventos, artistas o ciudades">
        <button type="submit" aria-label="Buscar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
                <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>
    </form>

    <div class="navbar-actions">
        <a class="navbar-link" href="https://wa.me/5493735535096?text=Hola,%20tengo%20una%20consulta%20sobre%20TuEntradaYa" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/>
                <path d="M9.5 9.2c.3-1 1.2-1.6 2.3-1.6 1.3 0 2.3.8 2.3 1.9 0 1.6-2.1 1.5-2.1 3.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                <circle cx="12" cy="16.3" r="0.9" fill="currentColor"/>
            </svg>
            <span>Centro de Ayuda</span>
        </a>
        <% if (typeof usuarioLogueado !== 'undefined' && usuarioLogueado) { %>
            <div class="profile-menu">
                <button type="button" class="profile-trigger" id="profileTrigger" aria-haspopup="true" aria-expanded="false">
                    <svg class="profile-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/>
                        <circle cx="12" cy="9.5" r="3.5" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M4.8 19c1.2-2.8 3.9-4.5 7.2-4.5s6 1.7 7.2 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    <span class="profile-name"><%= (typeof usuarioNombre !== 'undefined' && usuarioNombre) || 'Agustin Lopez' %></span>
                    <svg class="profile-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <div class="profile-dropdown" id="profileDropdown">
                    <a href="/mis-eventos">Mis eventos</a>
                    <% if (typeof esAdminLogueado !== 'undefined' && esAdminLogueado) { %>
                        <%# Solo se renderiza para administradores. Es un atajo visual: la ruta
                            está protegida por el middleware isAdmin, que verifica contra la
                            base — que este link no exista no es lo que da la seguridad. %>
                        <a href="/admin/dashboard">Panel de Administración</a>
                    <% } %>
                    <a href="/perfil">Editar perfil</a>
                    <hr>
                    <form action="/logout" method="POST">
                        <button type="submit" class="dropdown-logout">Cerrar sesión</button>
                    </form>
                </div>
            </div>
        <% } else { %>
            <a class="btn btn-ghost" href="/login">Iniciar sesión</a>
            <a class="btn btn-primary" href="/registro">Registrarme</a>
        <% } %>
    </div>
</nav>

<script>
    // Toggle del menú de perfil + cierre al hacer click afuera. Vanilla JS, sin dependencias.
    // Vive acá (no en un .js aparte) porque es un comportamiento propio de ESTE componente.
    (function () {
        const trigger = document.getElementById('profileTrigger');
        if (!trigger) return; // no hay sesión iniciada en esta página: no existe el dropdown

        const dropdown = document.getElementById('profileDropdown');

        function abrir() {
            dropdown.classList.add('open');
            trigger.setAttribute('aria-expanded', 'true');
        }
        function cerrar() {
            dropdown.classList.remove('open');
            trigger.setAttribute('aria-expanded', 'false');
        }

        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdown.classList.contains('open') ? cerrar() : abrir();
        });

        document.addEventListener('click', (e) => {
            if (!dropdown.contains(e.target) && e.target !== trigger) cerrar();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') cerrar();
        });
    })();
</script>
