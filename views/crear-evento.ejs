<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creá tu evento · TuEntrada</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .contenedor { max-width: 600px; margin: 0 auto; padding: 30px 20px 60px; }
        .volver { color: var(--text-muted); text-decoration: none; }
        h1 { margin-top: 10px; }
        .form-group { margin-bottom: 16px; }
        label { display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88rem; }
        input, textarea, select { width: 100%; font-family: inherit; }
        textarea { resize: vertical; min-height: 70px; }
        .nota { font-size: 0.78rem; color: var(--text-faint); margin-top: 20px; }
        .subtitulo-seccion { font-size: 1.05rem; margin: 32px 0 4px; padding-top: 20px; border-top: 1px solid var(--border); }
        .ayuda { font-size: 0.8rem; color: var(--text-faint); margin: 0 0 16px; }
        .opcional { font-weight: 400; color: var(--text-faint); font-size: 0.78rem; }

        /* Tipos de entrada dinámicos: uno o varios bloques iguales, agregables con "+" y
           quitables con "×" (salvo que sea el único que queda — siempre tiene que haber
           al menos un tipo de entrada para poder crear el evento). */
        .tipo-bloque {
            background: var(--bg-elevated-2); border: 1px solid var(--border);
            border-radius: var(--radius-md); padding: 16px; margin-bottom: 12px; position: relative;
        }
        .tipo-bloque-titulo { font-size: 0.8rem; font-weight: 700; color: var(--text-muted); margin: 0 0 12px; }
        .tipo-bloque .fila-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .btn-quitar-tipo {
            position: absolute; top: 12px; right: 12px; background: none; border: none;
            color: var(--text-faint); font-size: 1.1rem; line-height: 1; cursor: pointer; padding: 4px;
        }
        .btn-quitar-tipo:hover { color: var(--danger); }
        .btn-agregar-tipo {
            display: inline-flex; align-items: center; gap: 6px; background: var(--bg-elevated-2);
            border: 1px dashed var(--border); border-radius: var(--radius-full); color: var(--text);
            padding: 9px 18px; font-size: 0.85rem; font-weight: 600; cursor: pointer; margin-bottom: 20px;
        }
        .btn-agregar-tipo:hover { border-color: var(--accent); color: var(--accent-2); }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="contenedor">
    <a class="volver" href="/mis-eventos">&larr; Mis eventos</a>
    <h1>Creá tu evento</h1>
    <p style="color:var(--text-muted);">La tarifa por el uso del servicio se calcula sola y se le suma al precio que ve el comprador.</p>

    <% if (error) { %><div class="alerta-error" style="margin-bottom:15px;"><%= error %></div><% } %>

    <form action="/crear-evento" method="POST" enctype="multipart/form-data" id="form-crear-evento">
        <div class="form-group">
            <label for="nombre">Nombre del evento</label>
            <input type="text" id="nombre" name="nombre" required placeholder="Ej: Fiesta de fin de año">
        </div>

        <div class="form-group">
            <label for="descripcion">Descripción</label>
            <textarea id="descripcion" name="descripcion" required placeholder="Contales a tus invitados de qué se trata..."></textarea>
        </div>

        <div class="form-group">
            <label for="fecha">Fecha y hora</label>
            <!-- Calendario nativo en vez de texto libre: evita fechas mal tipeadas o con
                 formato inconsistente ("12/12" vs "12 de diciembre" vs texto suelto). -->
            <input type="datetime-local" id="fecha" name="fecha" required>
        </div>

        <div class="form-group">
            <label for="flyer">Imagen del flyer</label>
            <input type="file" id="flyer" name="flyer" accept="image/*" required>
            <p class="ayuda" style="margin-top:6px;">Se comprime automáticamente antes de subirse — no hace falta que la achiques vos.</p>
        </div>

        <h2 class="subtitulo-seccion">📍 Ubicación</h2>
        <div class="form-group">
            <label for="lugar_nombre">Nombre del lugar</label>
            <input type="text" id="lugar_nombre" name="lugar_nombre" placeholder="Ej: Club Atlético Central">
        </div>
        <div class="form-group">
            <label for="direccion">Dirección exacta</label>
            <input type="text" id="direccion" name="direccion" placeholder="Ej: Av. Siempre Viva 742">
        </div>
        <div class="form-group">
            <label for="ciudad">Ciudad</label>
            <input type="text" id="ciudad" name="ciudad" placeholder="Ej: Resistencia, Chaco">
        </div>
        <div class="form-group">
            <label for="maps_url">Link de Google Maps <span class="opcional">(opcional)</span></label>
            <input type="url" id="maps_url" name="maps_url" placeholder="https://maps.google.com/...">
        </div>

        <h2 class="subtitulo-seccion">🎟️ Tipos de entrada</h2>
        <p class="ayuda">Agregá los que necesites (General, VIP, Early Bird, etc.). Después vas a poder sumar más, editarlos o desactivarlos desde el panel del evento.</p>

        <!-- Bloques dinámicos: cada uno manda sus campos con name="tipo_xxx[]" (mismo nombre,
             terminado en []) — así el navegador los manda como un array de esos valores en el
             orden en que aparecen en el DOM, sin importar cuántos bloques haya ni el orden en
             que se agregaron/quitaron. El backend los lee en routes/organizador.js con
             [].concat(req.body.tipo_xxx) y arma un tipo de entrada por cada posición. -->
        <div id="tipos-entrada-container"></div>
        <button type="button" class="btn-agregar-tipo" id="btn-agregar-tipo">+ Agregar tipo de entrada</button>

        <div class="form-group">
            <label for="fecha_cierre_ventas">Cierre automático de ventas (opcional)</label>
            <input type="datetime-local" id="fecha_cierre_ventas" name="fecha_cierre_ventas">
        </div>

        <button class="btn btn-primary" type="submit" id="btn-crear-evento" style="width:100%;">Crear mi evento</button>
    </form>

    <p class="nota">Después de crear el evento te vamos a pedir que conectes tu Mercado Pago (un solo click) para poder empezar a vender.</p>
    </div>
    <script src="/flyer-comprimir.js"></script>
    <script>
        engancharCompresionFlyer('flyer');
        engancharSpinnerSubida('form-crear-evento', 'btn-crear-evento');
    </script>
    <script>
        // Tipos de entrada dinámicos: arranca con UN bloque precargado ("General", como antes)
        // y el botón "+" agrega tantos más como haga falta. Cada bloque tiene su "×" para
        // sacarlo, salvo que sea el único que queda (siempre hace falta al menos un tipo).
        (function () {
            const contenedor = document.getElementById('tipos-entrada-container');
            const btnAgregar = document.getElementById('btn-agregar-tipo');
            let contador = 0;

            function crearBloque({ nombre = '', descripcion = '', precio = '', cupo = '' } = {}) {
                contador++;
                const numero = contador;
                const bloque = document.createElement('div');
                bloque.className = 'tipo-bloque';
                bloque.innerHTML = `
                    <span class="tipo-bloque-titulo">Tipo de entrada #${numero}</span>
                    <button type="button" class="btn-quitar-tipo" aria-label="Quitar este tipo de entrada">✕</button>
                    <div class="form-group">
                        <label>Nombre</label>
                        <input type="text" name="tipo_nombre[]" placeholder="Ej: General, VIP, Early Bird" value="${nombre}" required>
                    </div>
                    <div class="form-group">
                        <label>Descripción <span class="opcional">(opcional, pero muy recomendable)</span></label>
                        <textarea name="tipo_descripcion[]" placeholder="Qué incluye esta entrada: acceso general, barra libre, etc.">${descripcion}</textarea>
                    </div>
                    <div class="fila-2">
                        <div class="form-group" style="margin-bottom:0;">
                            <label>Precio ($)</label>
                            <input type="number" step="1" min="1" name="tipo_precio[]" value="${precio}" required>
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label>Cupo disponible</label>
                            <input type="number" step="1" min="1" name="tipo_cupo[]" value="${cupo}" required>
                        </div>
                    </div>
                `;
                contenedor.appendChild(bloque);
                actualizarBotonesQuitar();
            }

            // El "×" solo se ve si hay más de un bloque — no tiene sentido dejar sin ningún
            // tipo de entrada, el evento necesita al menos uno para poder venderse.
            function actualizarBotonesQuitar() {
                const bloques = contenedor.querySelectorAll('.tipo-bloque');
                bloques.forEach((b) => {
                    const boton = b.querySelector('.btn-quitar-tipo');
                    boton.style.display = bloques.length > 1 ? '' : 'none';
                });
            }

            contenedor.addEventListener('click', (e) => {
                const boton = e.target.closest('.btn-quitar-tipo');
                if (!boton) return;
                boton.closest('.tipo-bloque').remove();
                actualizarBotonesQuitar();
            });

            btnAgregar.addEventListener('click', () => crearBloque());

            crearBloque({ nombre: 'General' }); // primer bloque precargado, igual que antes
        })();
    </script>
</body>
</html>
