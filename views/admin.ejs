<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin · TuEntrada</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .contenedor { max-width: 900px; margin: 0 auto; padding: 30px 20px 60px; }
        h1 { margin-bottom: 5px; }
        h3 { color: var(--text); }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; background: transparent; }
        th { text-align: left; padding: 8px; font-size: 13px; color: var(--text-muted); border-bottom: 1px solid var(--border); }
        td { text-align: left; padding: 8px; font-size: 13px; color: var(--text); border-bottom: 1px solid var(--border); }
        tbody tr:hover, table tr:hover td { background: var(--bg-elevated); }
        .badge { padding: 4px 11px; border-radius: 999px; font-size: 0.72rem; font-weight: 600; border: 1px solid transparent; }
        .activo { color: #34d399; background: rgba(52, 211, 153, 0.12); border-color: rgba(52, 211, 153, 0.3); }
        .sin-conectar { color: #fbbf24; background: rgba(251, 191, 36, 0.12); border-color: rgba(251, 191, 36, 0.3); }
        .btn-aprobar { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: white; border: none; padding: 7px 14px; border-radius: 999px; cursor: pointer; text-decoration: none; font-size: 12px; font-weight: 600; }
        .finalizado { color: var(--text-muted); background: rgba(161, 161, 170, 0.12); border-color: rgba(161, 161, 170, 0.25); }
        .acreditado { color: #34d399; background: rgba(52, 211, 153, 0.12); border-color: rgba(52, 211, 153, 0.3); }
        .en-revision { color: #fbbf24; background: rgba(251, 191, 36, 0.12); border-color: rgba(251, 191, 36, 0.3); }
        .btn-desacreditar { background: transparent; border: 1px solid var(--border); color: var(--text-muted); padding: 6px 12px; border-radius: 999px; cursor: pointer; font-size: 12px; }
        form.inline { display: inline; }

        .acordeon { border: 1px solid var(--border); border-radius: 14px; margin-bottom: 16px; overflow: hidden; }
        .acordeon > summary {
            cursor: pointer; padding: 14px 18px; background: var(--bg-elevated);
            font-weight: 600; font-size: 0.95rem; list-style: none; display: flex;
            justify-content: space-between; align-items: center;
        }
        .acordeon > summary::-webkit-details-marker { display: none; }
        .acordeon > summary::after { content: '▾'; color: var(--text-muted); transition: transform 200ms ease; }
        .acordeon[open] > summary::after { transform: rotate(180deg); }
        .acordeon-cuerpo { padding: 8px 14px 16px; }
        .acordeon-nota { color: var(--text-faint); font-size: 0.8rem; margin: 6px 0 0; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="contenedor">
    <h1>Panel de administración</h1>

    <h3>Usuarios esperando aprobación</h3>
    <% if (pendientes.length === 0) { %>
        <p style="color:var(--text-faint);">No hay solicitudes pendientes.</p>
    <% } else { %>
        <div class="table-scroll">
        <table>
            <tr><th>Nombre</th><th>Mail</th><th>Teléfono</th><th></th></tr>
            <% pendientes.forEach(u => { %>
                <tr>
                    <td><%= u.nombre %></td>
                    <td><%= u.email %></td>
                    <td><%= u.telefono %></td>
                    <td><a class="btn-aprobar" href="/admin/aprobar/<%= u.id %>?token=<%= u.token_aprobacion %>">Aprobar</a></td>
                </tr>
            <% }) %>
        </table>
        </div>
    <% } %>

    <h3 style="margin-top: 30px;">Eventos</h3>

    <details class="acordeon" open>
        <summary><span>🟢 Activos (<%= activos.length %>)</span></summary>
        <div class="acordeon-cuerpo">
            <% if (activos.length === 0) { %>
                <p class="acordeon-nota">No hay eventos activos.</p>
            <% } else { %>
                <div class="table-scroll">
                <table>
                    <tr><th>Nombre</th><th>Dueño</th><th>Mercado Pago</th><th>Acreditación</th><th></th></tr>
                    <% activos.forEach(evento => { %>
                        <tr>
                            <td><%= evento.nombre %></td>
                            <td><%= evento.dueño_email || '-' %></td>
                            <td><span class="badge <%= evento.conectado_mp ? 'activo' : 'sin-conectar' %>"><%= evento.conectado_mp ? 'Conectado' : 'Sin conectar' %></span></td>
                            <td>
                                <span class="badge <%= evento.is_admin_accredited ? 'acreditado' : 'en-revision' %>">
                                    <%= evento.is_admin_accredited ? 'Acreditado' : 'En revisión' %>
                                </span>
                            </td>
                            <td style="white-space:nowrap;">
                                <a href="/eventos/<%= evento.id %>">Ver panel</a>
                                <% if (evento.is_admin_accredited) { %>
                                    <form class="inline" action="/admin/eventos/<%= evento.id %>/acreditar" method="POST">
                                        <input type="hidden" name="acreditar" value="0">
                                        <button type="submit" class="btn-desacreditar">Quitar acreditación</button>
                                    </form>
                                <% } else { %>
                                    <form class="inline" action="/admin/eventos/<%= evento.id %>/acreditar" method="POST">
                                        <input type="hidden" name="acreditar" value="1">
                                        <button type="submit" class="btn-aprobar">Acreditar</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </table>
                </div>
            <% } %>
        </div>
    </details>

    <details class="acordeon">
        <summary><span>🏁 Finalizados (<%= finalizados.length %>)</span></summary>
        <div class="acordeon-cuerpo">
            <p class="acordeon-nota">Solo lectura: se pueden consultar, pero no editar. Sos el único que los puede eliminar de la base.</p>
            <% if (finalizados.length === 0) { %>
                <p class="acordeon-nota">No hay eventos finalizados.</p>
            <% } else { %>
                <div class="table-scroll">
                <table>
                    <tr><th>Nombre</th><th>Dueño</th><th>Fecha</th><th></th></tr>
                    <% finalizados.forEach(evento => { %>
                        <tr>
                            <td><%= evento.nombre %> <span class="badge finalizado">Finalizado</span></td>
                            <td><%= evento.dueño_email || '-' %></td>
                            <td><%= formatearFecha(evento.fecha) %></td>
                            <td><a href="/eventos/<%= evento.id %>">Ver panel</a></td>
                        </tr>
                    <% }) %>
                </table>
                </div>
            <% } %>
        </div>
    </details>
    </div>
</body>
</html>
