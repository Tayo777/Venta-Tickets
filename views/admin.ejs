<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .contenedor { max-width: 900px; margin: 0 auto; padding: 30px 20px 60px; }
        h1 { margin-bottom: 5px; }
        h3 { color: var(--text); }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; background: transparent; }
        th { text-align: left; padding: 8px; font-size: 13px; color: var(--text-muted); border-bottom: 1px solid var(--border); }
        td { text-align: left; padding: 8px; font-size: 13px; color: var(--text); border-bottom: 1px solid var(--border); }
        tbody tr:hover, table tr:hover td { background: var(--bg-elevated); }
        .badge { padding: 4px 11px; border-radius: 999px; font-size: 0.72rem; font-weight: 600; border: 1px solid transparent; }
        .activo { color: #34d399; background: rgba(52, 211, 153, 0.12); border-color: rgba(52, 211, 153, 0.3); }
        .sin-conectar { color: #fbbf24; background: rgba(251, 191, 36, 0.12); border-color: rgba(251, 191, 36, 0.3); }
        .btn-aprobar { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: white; border: none; padding: 7px 14px; border-radius: 999px; cursor: pointer; text-decoration: none; font-size: 12px; font-weight: 600; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="contenedor">
    <h1>Panel de administración</h1>

    <h3>Usuarios esperando aprobación</h3>
    <% if (pendientes.length === 0) { %>
        <p style="color:var(--text-faint);">No hay solicitudes pendientes.</p>
    <% } else { %>
        <div class="table-scroll">
        <table>
            <tr><th>Nombre</th><th>Mail</th><th>Teléfono</th><th></th></tr>
            <% pendientes.forEach(u => { %>
                <tr>
                    <td><%= u.nombre %></td>
                    <td><%= u.email %></td>
                    <td><%= u.telefono %></td>
                    <td><a class="btn-aprobar" href="/admin/aprobar/<%= u.id %>?token=<%= u.token_aprobacion %>">Aprobar</a></td>
                </tr>
            <% }) %>
        </table>
        </div>
    <% } %>

    <h3 style="margin-top: 30px;">Todos los eventos</h3>
    <div class="table-scroll">
    <table>
        <tr><th>Nombre</th><th>Dueño</th><th>Mercado Pago</th><th></th></tr>
        <% eventos.forEach(evento => { %>
            <tr>
                <td><%= evento.nombre %></td>
                <td><%= evento.dueño_email || '-' %></td>
                <td><span class="badge <%= evento.conectado_mp ? 'activo' : 'sin-conectar' %>"><%= evento.conectado_mp ? 'Conectado' : 'Sin conectar' %></span></td>
                <td><a href="/eventos/<%= evento.id %>">Ver panel</a></td>
            </tr>
        <% }) %>
    </table>
    </div>
    </div>
</body>
</html>
