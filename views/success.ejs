<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>¡Pago Exitoso! · TuEntradaYa</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .contenedor { max-width: 600px; margin: 60px auto 0; padding: 20px; text-align: center; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="contenedor">
    <h1>¡Pago realizado con éxito!</h1>
    <p style="color:var(--text-muted);">Gracias por tu compra, <strong style="color:var(--text);"><%= email %></strong>.</p>
    <p style="color:var(--text-muted);">Adquiriste <strong style="color:var(--text);"><%= cant %></strong> entrada(s) para <strong style="color:var(--text);"><%= evento.nombre %></strong>.</p>

    <a class="btn btn-primary" style="margin-top:20px;" href="/descargar-pdf?email=<%= email %>&cant=<%= cant %>">Descargar mis Entradas en PDF</a>
    </div>
</body>
</html>