<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis eventos · TuEntradaYa</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        :root {
            --zinc-950: #09090b;
            --zinc-900: #18181b;
            --zinc-800: #27272a;
            --zinc-400: #a1a1aa;
        }
        body { background: var(--zinc-950); }
        .contenedor { max-width: 800px; margin: 0 auto; padding: 30px 20px 60px; }

        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; gap: 16px; flex-wrap: wrap; }
        .page-header h1 { margin: 0; font-size: 1.4rem; }

        /* Tarjeta de evento: fondo zinc-900, borde sutil, se eleva mínimamente al hover
           (transform ya viaja en la transición global del theme, no hace falta redeclararla). */
        .evento-row {
            display: flex; justify-content: space-between; align-items: center;
            background: var(--zinc-900); border: 1px solid var(--zinc-800); border-radius: 14px;
            padding: 18px 20px; margin-bottom: 12px; text-decoration: none; color: inherit;
        }
        .evento-row:hover { transform: translateY(-2px); border-color: var(--accent); box-shadow: 0 8px 20px -8px rgba(139, 92, 246, 0.35); }
        .evento-row-thumb {
            width: 64px; height: 64px; flex-shrink: 0; border-radius: 10px;
            object-fit: cover; background: var(--zinc-800); margin-right: 16px;
        }
        .evento-row-info { flex: 1; min-width: 0; }
        .evento-row h3 { margin: 0 0 4px 0; font-size: 1.02rem; display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
        .evento-row p { margin: 0; color: var(--zinc-400); font-size: 0.85rem; }

        /* Badges tipo "neón sutil": texto brillante sobre fondo del mismo color muy oscuro/translúcido. */
        .badge {
            padding: 4px 11px; border-radius: 999px; font-size: 0.72rem; font-weight: 600;
            letter-spacing: 0.02em; border: 1px solid transparent;
        }
        .badge.activo { color: #34d399; background: rgba(52, 211, 153, 0.12); border-color: rgba(52, 211, 153, 0.3); }
        .badge.sin-conectar { color: #fbbf24; background: rgba(251, 191, 36, 0.12); border-color: rgba(251, 191, 36, 0.3); }
        .badge.finalizado { color: var(--zinc-400); background: rgba(161, 161, 170, 0.12); border-color: rgba(161, 161, 170, 0.25); }

        .vacio { text-align: center; color: var(--text-faint); margin-top: 60px; }

        /* Acordeones: "Eventos activos" arranca abierto, "Finalizados" cerrado (es historial). */
        .acordeon { border: 1px solid var(--zinc-800); border-radius: 14px; margin-bottom: 16px; overflow: hidden; }
        .acordeon > summary {
            cursor: pointer; padding: 14px 18px; background: var(--zinc-900);
            font-weight: 600; font-size: 0.95rem; list-style: none; display: flex;
            justify-content: space-between; align-items: center; gap: 10px;
        }
        .acordeon > summary::-webkit-details-marker { display: none; }
        .acordeon > summary::after { content: '▾'; color: var(--zinc-400); transition: transform 200ms ease; }
        .acordeon[open] > summary::after { transform: rotate(180deg); }
        .acordeon > summary:hover { background: var(--zinc-800); }
        .acordeon-cuerpo { padding: 14px; }
        .acordeon-contador { color: var(--zinc-400); font-weight: 400; font-size: 0.82rem; }
        .acordeon-nota { color: var(--text-faint); font-size: 0.8rem; margin: 0 0 12px; }

        /* Recordatorio sutil (no un bloqueo) de verificar el mail. */
        .aviso-mail-pendiente {
            border: 1px solid rgba(251, 191, 36, 0.35); background: rgba(251, 191, 36, 0.08);
            border-radius: 12px; padding: 12px 16px; margin-bottom: 20px;
            color: #fbbf24; font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="contenedor">
    <div class="page-header">
        <h1>Mis eventos<% if (esAdmin) { %> <span style="color:var(--zinc-400); font-weight:400; font-size:0.9rem;">(todos, sos admin)</span><% } %></h1>
        <a class="btn btn-primary" href="/crear-evento">+ Crear evento</a>
    </div>

    <!-- Aviso sutil, no un bloqueo: ya se puede navegar y crear eventos sin el mail
         verificado, pero sin verificarlo ningún evento propio llega a ser público (ver el
         banner grande en el panel de cada evento). -->
    <% if (typeof emailVerificado !== 'undefined' && !emailVerificado) { %>
        <div class="aviso-mail-pendiente">
            ✉️ Todavía no confirmaste tu correo electrónico — hacelo para que tus eventos
            puedan hacerse públicos. Revisá la casilla que te llegó al registrarte.
        </div>
    <% } %>

    <% if (activos.length === 0 && finalizados.length === 0) { %>
        <p class="vacio">Todavía no creaste ningún evento.</p>
    <% } else { %>
        <details class="acordeon" open>
            <summary>
                <span>🟢 Eventos activos <span class="acordeon-contador">(<%= activos.length %>)</span></span>
            </summary>
            <div class="acordeon-cuerpo">
                <% if (activos.length === 0) { %>
                    <p class="acordeon-nota">No tenés eventos activos en este momento.</p>
                <% } else { %>
                    <% activos.forEach(evento => { %>
                        <%- include('partials/tarjeta-evento', { evento, finalizado: false }) %>
                    <% }) %>
                <% } %>
            </div>
        </details>

        <details class="acordeon">
            <summary>
                <span>🏁 Eventos finalizados <span class="acordeon-contador">(<%= finalizados.length %>)</span></span>
            </summary>
            <div class="acordeon-cuerpo">
                <p class="acordeon-nota">Quedan en modo solo lectura: podés entrar a ver estadísticas, ventas e historial, pero ya no se editan.</p>
                <% if (finalizados.length === 0) { %>
                    <p class="acordeon-nota">Todavía no hay eventos finalizados.</p>
                <% } else { %>
                    <% finalizados.forEach(evento => { %>
                        <%- include('partials/tarjeta-evento', { evento, finalizado: true }) %>
                    <% }) %>
                <% } %>
            </div>
        </details>
    <% } %>
    </div>
</body>
</html>
