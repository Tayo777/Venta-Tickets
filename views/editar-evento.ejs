<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar evento</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 600px; margin: 40px auto; padding: 20px; }
        .volver { color: #636e72; text-decoration: none; }
        .form-group { margin-bottom: 16px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; }
        input, textarea { width: 100%; padding: 8px; box-sizing: border-box; font-family: inherit; }
        textarea { resize: vertical; min-height: 70px; }
        button { background: #009ee3; color: white; border: none; padding: 12px 15px; width: 100%; font-size: 16px; border-radius: 5px; cursor: pointer; margin-top: 10px; }
        .error { background: #fdecea; color: #c0392b; padding: 10px 15px; border-radius: 6px; margin-bottom: 15px; font-size: 0.9rem; }
        img { max-width: 200px; display: block; margin-bottom: 10px; border-radius: 8px; }
    </style>
</head>
<body>
    <a class="volver" href="/eventos/<%= evento.id %>">&larr; Volver al evento</a>
    <h1>Editar evento</h1>

    <% if (error) { %><div class="error"><%= error %></div><% } %>

    <form action="/eventos/<%= evento.id %>/editar" method="POST" enctype="multipart/form-data"
          onsubmit="return confirm('¿Confirmás guardar estos cambios?');">
        <div class="form-group">
            <label>Nombre del evento</label>
            <input type="text" name="nombre" value="<%= evento.nombre %>" required>
        </div>
        <div class="form-group">
            <label>Descripción</label>
            <textarea name="descripcion" required><%= evento.descripcion %></textarea>
        </div>
        <div class="form-group">
            <label>Fecha y hora</label>
            <input type="text" name="fecha" value="<%= evento.fecha %>" required>
        </div>
        <div class="form-group">
            <label>Flyer actual</label>
            <img src="<%= evento.flyer_url %>" alt="Flyer actual">
            <label>Reemplazar imagen (opcional)</label>
            <input type="file" name="flyer" accept="image/*">
        </div>
        <div class="form-group">
            <label>Precio de la entrada ($)</label>
            <input type="number" step="1" min="1" name="valor_entrada" value="<%= evento.valor_entrada %>" required>
        </div>
        <button type="submit">Guardar cambios</button>
    </form>
</body>
</html>
