<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eventos disponibles</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .contenido { max-width: 700px; margin: 0 auto; padding: 30px 20px; }
        h1 { text-align: center; }
        .evento-card { display: block; text-decoration: none; color: inherit; overflow: hidden; margin-bottom: 20px; }
        .evento-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-glow); }
        .evento-card img { width: 100%; max-height: 250px; object-fit: cover; display: block; }
        .evento-info { padding: 16px; }
        .evento-info h2 { margin: 0 0 5px 0; color: var(--text); }
        .evento-info p { margin: 0; color: var(--text-muted); }
        .vacio { text-align: center; color: var(--text-faint); margin-top: 60px; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="contenido">
        <h1>Próximos eventos</h1>

        <% if (eventos.length === 0) { %>
            <p class="vacio">No hay eventos disponibles por el momento.</p>
        <% } else { %>
            <% eventos.forEach(evento => { %>
                <a class="evento-card card" href="/evento/<%= evento.id %>">
                    <img src="<%= evento.flyer_url %>" alt="Flyer de <%= evento.nombre %>">
                    <div class="evento-info">
                        <h2><%= evento.nombre %></h2>
                        <p><%= evento.fecha %></p>
                    </div>
                </a>
            <% }) %>
        <% } %>
    </div>
</body>
</html>
