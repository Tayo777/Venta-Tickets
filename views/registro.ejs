<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creá tu cuenta · TuEntrada</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/auth-split.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="auth-split">
        <div class="auth-split-brand">
            <div>
                <h1>Únete a GetPass</h1>
                <p>Creá tu cuenta y empezá a gestionar tus eventos de forma profesional.</p>
            </div>
        </div>
        <div class="auth-split-form">
            <div class="auth-form-box">
                <h2>Creá tu cuenta</h2>
                <p class="auth-form-sub">Para poder crear eventos, primero necesitamos verificar tu mail y aprobar tu cuenta.</p>

                <% if (error) { %><div class="alerta-error" style="margin-bottom:15px;"><%= error %></div><% } %>

                <form action="/registro" method="POST">
                    <div class="form-group">
                        <label for="nombre">Nombre y apellido</label>
                        <input type="text" id="nombre" name="nombre" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Mail</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="telefono">Teléfono (para que podamos contactarte)</label>
                        <input type="tel" id="telefono" name="telefono" required placeholder="Ej: 3624123456">
                    </div>
                    <div class="form-group">
                        <label for="password">Contraseña (mínimo 8 caracteres)</label>
                        <input type="password" id="password" name="password" required minlength="8">
                    </div>
                    <button class="btn btn-primary" type="submit" style="width:100%; margin-top:10px;">Crear cuenta</button>
                </form>

                <p class="link">¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a></p>
            </div>
        </div>
    </div>
</body>
</html>
