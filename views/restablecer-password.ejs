<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elegí una contraseña nueva</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .contenedor { max-width: 420px; margin: 60px auto 0; padding: 20px; }
        .form-group { margin-bottom: 14px; }
        label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.88rem; }
        input { width: 100%; }
        button { width: 100%; margin-top: 10px; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="contenedor">
    <h1>Elegí una contraseña nueva</h1>
    <% if (error) { %><div class="alerta-error" style="margin-bottom:15px;"><%= error %></div><% } %>
    <form action="/restablecer-password/<%= token %>" method="POST">
        <div class="form-group">
            <label for="password">Contraseña nueva (mínimo 8 caracteres)</label>
            <input type="password" id="password" name="password" required minlength="8">
        </div>
        <button class="btn btn-primary" type="submit">Cambiar contraseña</button>
    </form>
    </div>
</body>
</html>
