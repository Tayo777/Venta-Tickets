<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar contraseña · TuEntradaYa</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .contenedor { max-width: 420px; margin: 60px auto 0; padding: 20px; }
        .form-group { margin-bottom: 14px; }
        label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.88rem; }
        input { width: 100%; }
        button { width: 100%; margin-top: 10px; }
        .link { text-align: center; margin-top: 15px; font-size: 0.9rem; color: var(--text-muted); }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="contenedor">
    <h1>Recuperar contraseña</h1>

    <% if (enviado) { %>
        <div class="alerta-ok">Si ese mail está registrado, te mandamos un link para restablecer tu contraseña. Revisá tu casilla (y spam).</div>
    <% } else { %>
        <p style="color:var(--text-muted);">Ingresá tu mail y te mandamos un link para elegir una contraseña nueva.</p>
        <form action="/recuperar-password" method="POST">
            <div class="form-group">
                <label for="email">Mail</label>
                <input type="email" id="email" name="email" required>
            </div>
            <button class="btn btn-primary" type="submit">Enviar link</button>
        </form>
    <% } %>

    <p class="link"><a href="/login">Volver a iniciar sesión</a></p>
    </div>
</body>
</html>
