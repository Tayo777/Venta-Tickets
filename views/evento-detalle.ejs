<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% if (evento.conectado_mp) { %><meta http-equiv="refresh" content="30"><% } %>
    <title>Panel de <%= evento.nombre %></title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        :root {
            --zinc-900: #18181b;
            --zinc-800: #27272a;
            --zinc-300: #d4d4d8;
            --zinc-400: #a1a1aa;
        }
        .contenedor { max-width: 800px; margin: 0 auto; padding: 30px 20px 60px; }
        .volver {
            display: inline-flex; align-items: center; gap: 6px;
            color: var(--zinc-400); text-decoration: none; font-size: 0.88rem; font-weight: 500;
            padding: 6px 2px; transition: color 150ms ease, transform 150ms ease;
        }
        .volver:hover { color: var(--accent-2); transform: translateX(-2px); }
        h1 { margin-bottom: 0; }
        .subtitulo { color: var(--text-muted); margin-top: 4px; }
        .aviso-ok { background: var(--success-bg); color: var(--success); padding: 12px 15px; border-radius: 10px; margin: 15px 0; border: 1px solid rgba(52, 211, 153, 0.25); }

        /* Tarjeta de Mercado Pago destacada: borde violeta brillante sutil (doble capa de
           box-shadow, no un simple "border") para que resalte como EL método recomendado. */
        .conectar-box {
            background: var(--zinc-900); color: white; padding: 30px; border-radius: 14px; margin: 20px 0;
            text-align: center; position: relative;
            box-shadow: 0 0 0 1px rgba(139, 92, 246, 0.55), 0 0 32px rgba(139, 92, 246, 0.28);
        }
        .conectar-box .badge-recomendado {
            position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
            background: linear-gradient(135deg, #8b5cf6, #22d3ee); color: white; font-size: 0.7rem;
            font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
            padding: 5px 14px; border-radius: 999px;
        }
        .conectar-box h2 { margin-top: 6px; }
        .conectar-box p { color: var(--zinc-300); font-size: 0.9rem; }
        .beneficios-mp {
            list-style: none; padding: 0; margin: 18px auto 22px; max-width: 320px;
            text-align: left; display: flex; flex-direction: column; gap: 9px;
        }
        .beneficios-mp li { display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--zinc-300); }
        .beneficios-mp li::before { content: '✓'; color: #22d3ee; font-weight: bold; }
        .btn-mp {
            display: inline-block; background: linear-gradient(135deg, #8b5cf6, #22d3ee); color: white;
            font-weight: bold; padding: 14px 34px; border-radius: 50px; text-decoration: none;
            margin-top: 10px; transition: transform 150ms ease, box-shadow 150ms ease;
        }
        .btn-mp:hover { box-shadow: 0 0 24px rgba(139, 92, 246, 0.5); transform: translateY(-1px); }
        .btn-mp:active { transform: scale(0.97); }

        /* Métricas: grid de tarjetas oscuras, borde sutil casi imperceptible salvo al mirar de cerca. */
        .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 20px; }
        @media (max-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
        .card { background: var(--zinc-900); border: 1px solid var(--zinc-800); border-radius: 12px; padding: 16px; text-align: center; }
        .card .numero { font-size: 1.5rem; font-weight: 700; color: var(--text); }
        .card .etiqueta { color: var(--zinc-400); font-size: 0.78rem; margin-top: 4px; }

        /* Link de venta pública: informativo, tono neutro-acento. */
        .link-box { margin-top: 20px; background: var(--zinc-900); border: 1px solid var(--zinc-800); padding: 15px; border-radius: 12px; font-size: 0.85rem; word-break: break-all; }
        .link-box a { color: var(--accent-2); }
        .link-box strong { display: block; margin-bottom: 4px; color: var(--text); }
        /* Link del guardia: rojo oscuro/translúcido, para que se lea como "manejar con cuidado". */
        .link-box.peligro { background: rgba(248, 113, 113, 0.08); border-color: rgba(248, 113, 113, 0.35); }
        .link-box.peligro a { color: #fca5a5; }
        .link-box .aviso { color: #fca5a5; font-weight: bold; font-size: 0.8rem; display: block; margin-top: 6px; }

        .acciones { display: flex; gap: 10px; margin-top: 25px; }
        .acciones button, .acciones a { flex: 1; padding: 10px; border-radius: 999px; text-align: center; text-decoration: none; cursor: pointer; border: 1px solid var(--zinc-800); font-size: 0.9rem; }
        .btn-editar { background: var(--zinc-900); color: var(--text); }
        .btn-editar:hover { border-color: var(--accent); color: var(--accent-2); }
        .btn-eliminar { background: var(--danger-bg); color: var(--danger); border-color: rgba(248, 113, 113, 0.3); }
        .btn-eliminar:hover { background: rgba(248, 113, 113, 0.16); }

        /* Tabla de ventas: fondo transparente, fila resaltada al pasar el mouse. */
        table { width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 0.82rem; background: transparent; }
        th { text-align: left; padding: 8px; color: var(--zinc-400); font-weight: 600; border-bottom: 1px solid var(--zinc-800); }
        td { text-align: left; padding: 8px; color: var(--zinc-300); border-bottom: 1px solid var(--zinc-800); }
        tbody tr:hover, table tr:hover td { background: var(--zinc-900); }

        .nota { text-align: center; color: var(--text-faint); font-size: 0.8rem; margin-top: 20px; }

        /* Módulos de acción (cortesía / reenvío / export): misma tarjeta oscura que las métricas. */
        .panel-op { background: var(--zinc-900); border: 1px solid var(--zinc-800); border-radius: 12px; padding: 18px; margin-top: 20px; }
        .panel-op h3 { margin-top: 0; color: var(--text); }
        .panel-op .fila { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
        .panel-op input {
            flex: 1; min-width: 120px; background: var(--zinc-900); color: var(--text);
            border: 1px solid var(--zinc-800); border-radius: 999px; padding: 9px 16px;
        }
        .panel-op button {
            padding: 9px 18px; border: none; border-radius: 999px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: white; cursor: pointer; font-weight: 600;
        }
        .panel-op button:active { transform: scale(0.97); }

        /* Gráfico de flujo de ingreso: solo divs con ancho calculado en JS (sin librerías). */
        .grafico-horas { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
        .fila-hora { display: flex; align-items: center; gap: 10px; font-size: 0.78rem; }
        .fila-hora .etiqueta-hora { width: 42px; flex-shrink: 0; color: var(--zinc-400); text-align: right; }
        .fila-hora .barra-pista { flex: 1; background: var(--zinc-800); border-radius: 999px; height: 16px; overflow: hidden; }
        .fila-hora .barra-relleno {
            height: 100%; min-width: 4px; border-radius: 999px;
            background: linear-gradient(90deg, var(--accent), var(--accent-2));
        }
        .fila-hora .valor-hora { width: 26px; flex-shrink: 0; color: var(--text); font-weight: 600; }

        /* Tarjeta del gráfico de Chart.js: mismo fondo zinc-900 de las demás, pero con una
           sombra suave propia (las otras tarjetas del panel solo llevan borde). */
        .grafico-card { box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.6); }
        .grafico-lienzo { position: relative; height: 220px; margin-top: 10px; }
        .btn-export {
            display: inline-block; margin-top: 8px; padding: 9px 18px; border-radius: 999px;
            background: transparent; color: var(--accent-2); text-decoration: none; font-size: 0.85rem;
            border: 1px solid var(--zinc-800);
        }
        .btn-export:hover { border-color: var(--accent-2); background: rgba(34, 211, 238, 0.08); }

        /* Aviso de SPAM: tonos mostaza/amarillo oscuro (no rojo — no es un error, es una guía). */
        .aviso-spam {
            border: 1px solid rgba(217, 164, 6, 0.4); background: rgba(133, 100, 4, 0.18);
            border-radius: 10px; padding: 12px 14px; margin-top: 12px; font-size: 0.82rem;
            color: #facc15; font-weight: 600;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="contenedor">
    <a class="volver" href="/mis-eventos">&larr; Volver a Mis Eventos</a>
    <h1><%= evento.nombre %></h1>
    <p class="subtitulo"><%= formatearFecha(evento.fecha) %></p>

    <% if (conectado) { %>
        <div class="aviso-ok">✅ ¡Tu Mercado Pago quedó conectado! Ya podés compartir el link de venta.</div>
    <% } %>
    <% if (typeof cortesia !== 'undefined' && cortesia) { %>
        <div class="aviso-ok">🎟️ Entradas de cortesía generadas y enviadas por mail.</div>
    <% } %>
    <% if (typeof reenviado !== 'undefined' && reenviado) { %>
        <div class="aviso-ok">📩 Entradas reenviadas correctamente.</div>
    <% } %>

    <% if (!evento.conectado_mp) { %>
        <div class="conectar-box">
            <span class="badge-recomendado">Recomendado</span>
            <h2>Conectá tu Mercado Pago</h2>
            <p>Falta un solo paso para poder vender: conectá tu cuenta para que el dinero de cada venta te llegue directo a vos.</p>
            <ul class="beneficios-mp">
                <li>Pagos al instante</li>
                <li>Pagos seguros, sin intermediarios</li>
                <li>El dinero llega directo a tu cuenta</li>
                <li>Sin cargo extra por usar la plataforma</li>
            </ul>
            <a class="btn-mp" href="<%= urlConexionMP %>">Conectar con Mercado Pago</a>
        </div>
    <% } else { %>
        <div class="grid">
            <div class="card"><div class="numero"><%= resumen.total_vendidas || 0 %></div><div class="etiqueta">Vendidas</div></div>
            <div class="card"><div class="numero"><%= resumen.total_ingresadas || 0 %></div><div class="etiqueta">Ingresaron</div></div>
            <div class="card"><div class="numero"><%= resumen.total_compradores || 0 %></div><div class="etiqueta">Compradores</div></div>
            <div class="card"><div class="numero">$<%= recaudacion.toLocaleString('es-AR') %></div><div class="etiqueta">Recaudación</div></div>
        </div>

        <div class="panel-op" id="flujo-ingreso-box">
            <h3>📈 Flujo de ingreso por hora</h3>
            <div id="flujo-ingreso-grafico" class="grafico-horas">
                <p style="color:var(--zinc-400); font-size:0.85rem; margin:0;">Cargando...</p>
            </div>
        </div>

        <div class="panel-op grafico-card">
            <h3>📊 Ventas en el tiempo</h3>
            <div class="grafico-lienzo">
                <canvas id="graficoVentas"></canvas>
            </div>
        </div>

        <div class="link-box">
            <strong>Link para vender tus entradas:</strong>
            <a href="<%= urlPublica %>" target="_blank"><%= urlPublica %></a>
        </div>

        <div class="link-box peligro">
            <strong>🔒 Link privado para el guardia de seguridad:</strong>
            <a href="<%= urlGuardia %>" target="_blank"><%= urlGuardia %></a>
            <span class="aviso">No lo compartas con nadie que no sea personal de seguridad de ESTE evento. Cualquiera que lo abra puede validar entradas.</span>
        </div>
    <% } %>

    <div class="acciones">
        <a class="btn-editar" href="/eventos/<%= evento.id %>/editar">Editar evento</a>
        <form action="/eventos/<%= evento.id %>/eliminar" method="POST" style="flex:1;"
              onsubmit="return confirm('¿Estás SEGURO que querés eliminar este evento? Se van a borrar también todas sus entradas vendidas. Esta acción no se puede deshacer.');">
            <button class="btn-eliminar" type="submit" style="width:100%;">Eliminar evento</button>
        </form>
    </div>

    <div class="panel-op">
        <h3>🎟️ Entradas de cortesía</h3>
        <p style="font-size:0.82rem; color:var(--zinc-400); margin:0;">Genera QRs válidos sin cobrar (invitados, prensa, staff) y los manda por mail al toque.</p>
        <form action="/eventos/<%= evento.id %>/cortesia" method="POST" class="fila">
            <input type="text" name="nombre_apellido" placeholder="Nombre y apellido" required>
            <input type="email" name="email" placeholder="Email del invitado" required>
            <input type="number" name="cantidad" placeholder="Cant." min="1" max="20" value="1" required style="max-width:80px;">
            <button type="submit">Generar y enviar</button>
        </form>
    </div>

    <div class="panel-op">
        <h3>📩 Reenviar QR</h3>
        <p style="font-size:0.82rem; color:var(--zinc-400); margin:0;">Reenvía TODAS las entradas de ese email para este evento (no genera entradas nuevas).</p>
        <form action="/eventos/<%= evento.id %>/reenviar-qr" method="POST" class="fila">
            <input type="email" name="email" placeholder="Email del comprador" required>
            <button type="submit">Reenviar</button>
        </form>
        <div class="aviso-spam">
            ⚠️ Si el asistente dice que "no le llegó" el mail con la entrada, primero pedile que revise
            la carpeta de <strong>SPAM / Correo no deseado</strong> antes de reenviar — la mayoría de los
            casos están ahí.
        </div>
    </div>

    <div class="panel-op">
        <h3>📋 Exportación de contingencia</h3>
        <p style="font-size:0.82rem; color:var(--zinc-400); margin:0;">Descargá la lista completa de asistentes (CSV, se abre directo en Excel) para tener offline en la puerta.</p>
        <a class="btn-export" href="/eventos/<%= evento.id %>/exportar-csv">⬇ Descargar CSV</a>
    </div>

    <% if (ventas.length > 0) { %>
        <h3 style="margin-top: 30px;">Ventas realizadas</h3>
        <div class="table-scroll">
        <table>
            <tr>
                <th>ID cliente</th>
                <th>Nombre y apellido</th>
                <th>Email</th>
                <th>Tipo</th>
                <th>ID entrada</th>
                <th>Estado</th>
                <th>Fecha compra</th>
                <th>Fecha escaneada</th>
            </tr>
            <% ventas.forEach(v => { %>
                <tr>
                    <td><%= v.id_cliente || '-' %></td>
                    <td><%= v.nom_y_apellido || '-' %></td>
                    <td><%= v.email || '-' %></td>
                    <td><%= v.tipo_entrada || (v.origen === 'cortesia' ? 'Cortesía' : '-') %></td>
                    <td><%= v.id_entrada %></td>
                    <td><%= v.estado_entrada %></td>
                    <td><%= v.fecha_y_hora_compra ? new Date(v.fecha_y_hora_compra).toLocaleString('es-AR') : '-' %></td>
                    <td><%= v.fecha_y_hora_escaneada ? new Date(v.fecha_y_hora_escaneada).toLocaleString('es-AR') : '-' %></td>
                </tr>
            <% }) %>
        </table>
        </div>
    <% } %>

    <p class="nota">Esta página se actualiza sola cada 30 segundos.</p>
    </div>

    <script>
        // Dibuja el flujo de ingreso por hora con divs simples (sin librerías de gráficos):
        // una fila por hora, con una "pista" gris y un relleno cuyo ancho en % es
        // cantidad/máximo — la hora con más ingresos siempre llena el 100% de la barra.
        (function () {
            const contenedor = document.getElementById('flujo-ingreso-grafico');
            if (!contenedor) return; // evento sin Mercado Pago conectado todavía: no hay métricas

            async function cargar() {
                try {
                    const resp = await fetch('/api/eventos/<%= evento.id %>/ingresos-hora');
                    const { datos } = await resp.json();

                    if (!datos || datos.length === 0) {
                        contenedor.innerHTML = '<p style="color:var(--zinc-400); font-size:0.85rem; margin:0;">Todavía no hay ingresos escaneados.</p>';
                        return;
                    }

                    const maximo = Math.max(...datos.map((d) => d.cantidad));
                    contenedor.innerHTML = datos.map((d) => {
                        const porcentaje = Math.round((d.cantidad / maximo) * 100);
                        const horaTexto = String(d.hora).padStart(2, '0') + ':00';
                        return `
                            <div class="fila-hora">
                                <span class="etiqueta-hora">${horaTexto}</span>
                                <div class="barra-pista"><div class="barra-relleno" style="width:${porcentaje}%;"></div></div>
                                <span class="valor-hora">${d.cantidad}</span>
                            </div>
                        `;
                    }).join('');
                } catch (error) {
                    contenedor.innerHTML = '<p style="color:var(--danger); font-size:0.85rem; margin:0;">No se pudo cargar el gráfico.</p>';
                    console.error('Error al cargar ingresos por hora:', error);
                }
            }

            cargar();
            setInterval(cargar, 20000); // se refresca solo, independiente del reload de toda la página
        })();
    </script>

    <script>
        // Gráfico de líneas de ventas en el tiempo, con Chart.js. Paleta pensada para calzar
        // con el Dark Mode Premium del resto del panel: línea en el color de acento, ejes y
        // textos en gris tenue, sin grilla invasiva (solo una línea horizontal muy sutil).
        (function () {
            const canvas = document.getElementById('graficoVentas');
            if (!canvas || typeof Chart === 'undefined') return; // evento sin MP conectado, o el CDN no cargó

            const ESTILOS = getComputedStyle(document.documentElement);
            const COLOR_ACENTO = ESTILOS.getPropertyValue('--accent').trim() || '#8b5cf6';
            const COLOR_ACENTO_2 = ESTILOS.getPropertyValue('--accent-2').trim() || '#22d3ee';
            const COLOR_TEXTO_TENUE = '#a1a1aa'; // text-zinc-400
            const COLOR_GRILLA = 'rgba(161, 161, 170, 0.08)'; // casi invisible, solo una guía leve

            let grafico = null;

            async function cargar() {
                try {
                    const resp = await fetch('/api/eventos/<%= evento.id %>/grafico-ventas');
                    const { datos } = await resp.json();

                    const etiquetas = (datos || []).map((d) =>
                        new Date(d.fecha).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit' })
                    );
                    const valores = (datos || []).map((d) => Number(d.entradas_vendidas));

                    if (grafico) grafico.destroy();
                    grafico = new Chart(canvas.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: etiquetas,
                            datasets: [{
                                label: 'Entradas vendidas',
                                data: valores,
                                borderColor: COLOR_ACENTO,
                                backgroundColor: (ctx) => {
                                    // Relleno degradado sutil bajo la línea, en vez de un bloque sólido.
                                    const { chartArea, ctx: c } = ctx.chart;
                                    if (!chartArea) return 'transparent';
                                    const gradiente = c.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                                    gradiente.addColorStop(0, 'rgba(139, 92, 246, 0.25)');
                                    gradiente.addColorStop(1, 'rgba(139, 92, 246, 0)');
                                    return gradiente;
                                },
                                fill: true,
                                tension: 0.35, // línea curva y fluida, no quebrada
                                borderWidth: 2,
                                pointRadius: 3,
                                pointBackgroundColor: COLOR_ACENTO_2,
                                pointBorderColor: COLOR_ACENTO_2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false }, // un solo dataset: la leyenda no aporta nada
                                tooltip: {
                                    backgroundColor: '#18181b',
                                    borderColor: '#27272a',
                                    borderWidth: 1,
                                    titleColor: '#f4f4f5',
                                    bodyColor: COLOR_TEXTO_TENUE,
                                    padding: 10,
                                    displayColors: false
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false }, // sin grilla vertical: se ve mucho más limpio
                                    ticks: { color: COLOR_TEXTO_TENUE, font: { size: 11 } }
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: COLOR_GRILLA, drawTicks: false },
                                    border: { display: false },
                                    ticks: { color: COLOR_TEXTO_TENUE, font: { size: 11 }, precision: 0 }
                                }
                            }
                        }
                    });
                } catch (error) {
                    console.error('Error al cargar el gráfico de ventas:', error);
                }
            }

            cargar();
            setInterval(cargar, 30000);
        })();
    </script>
</body>
</html>
