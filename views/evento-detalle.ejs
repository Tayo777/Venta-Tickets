<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de <%= evento.nombre %></title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        :root {
            --zinc-900: #18181b;
            --zinc-800: #27272a;
            --zinc-300: #d4d4d8;
            --zinc-400: #a1a1aa;
        }
        .contenedor { max-width: 800px; margin: 0 auto; padding: 30px 20px 60px; }
        .volver {
            display: inline-flex; align-items: center; gap: 6px;
            color: var(--zinc-400); text-decoration: none; font-size: 0.88rem; font-weight: 500;
            padding: 6px 2px; transition: color 150ms ease, transform 150ms ease;
        }
        .volver:hover { color: var(--accent-2); transform: translateX(-2px); }
        h1 { margin-bottom: 0; }
        .subtitulo { color: var(--text-muted); margin-top: 4px; }

        .encabezado-evento { margin-bottom: 4px; }
        .btn-actualizar {
            display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0;
            background: var(--zinc-900); color: var(--text); border: 1px solid var(--zinc-800);
            border-radius: 999px; padding: 10px 20px; font-size: 0.88rem; font-weight: 600;
            cursor: pointer; transition: border-color 150ms ease, color 150ms ease, transform 150ms ease;
        }
        .btn-actualizar:hover { border-color: var(--accent); color: var(--accent-2); }
        .btn-actualizar:active { transform: scale(0.97); }
        .btn-actualizar:disabled { opacity: 0.6; cursor: default; transform: none; }
        .btn-actualizar.girando { animation: girar-actualizar 800ms linear infinite; }
        @keyframes girar-actualizar { to { transform: rotate(360deg); } }
        @media (max-width: 480px) { .btn-actualizar { width: 100%; justify-content: center; } }
        .aviso-ok { background: var(--success-bg); color: var(--success); padding: 12px 15px; border-radius: 10px; margin: 15px 0; border: 1px solid rgba(52, 211, 153, 0.25); }

        /* ---------- Pestañas ---------- */
        .tabs-nav {
            display: flex; gap: 6px; margin: 22px 0 20px; border-bottom: 1px solid var(--zinc-800);
            overflow-x: auto; -webkit-overflow-scrolling: touch;
        }
        .tab-btn {
            flex-shrink: 0; background: none; border: none; cursor: pointer;
            color: var(--zinc-400); font-size: 0.9rem; font-weight: 600;
            padding: 10px 16px; border-bottom: 2px solid transparent;
            transition: color 150ms ease, border-color 150ms ease;
        }
        .tab-btn:hover { color: var(--text); }
        .tab-btn.activo { color: var(--accent-2); border-bottom-color: var(--accent-2); }
        .tab-panel[hidden] { display: none; }

        /* Tarjeta de Mercado Pago destacada: borde violeta brillante sutil (doble capa de
           box-shadow, no un simple "border") para que resalte como EL método recomendado. */
        .conectar-box {
            background: var(--zinc-900); color: white; padding: 30px; border-radius: 14px; margin: 20px 0;
            text-align: center; position: relative;
            box-shadow: 0 0 0 1px rgba(139, 92, 246, 0.55), 0 0 32px rgba(139, 92, 246, 0.28);
        }
        .conectar-box .badge-recomendado {
            position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
            background: linear-gradient(135deg, #8b5cf6, #22d3ee); color: white; font-size: 0.7rem;
            font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
            padding: 5px 14px; border-radius: 999px;
        }
        .conectar-box h2 { margin-top: 6px; }
        .conectar-box p { color: var(--zinc-300); font-size: 0.9rem; }
        .beneficios-mp {
            list-style: none; padding: 0; margin: 18px auto 22px; max-width: 320px;
            text-align: left; display: flex; flex-direction: column; gap: 9px;
        }
        .beneficios-mp li { display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--zinc-300); }
        .beneficios-mp li::before { content: '✓'; color: #22d3ee; font-weight: bold; }
        .btn-mp {
            display: inline-block; background: linear-gradient(135deg, #8b5cf6, #22d3ee); color: white;
            font-weight: bold; padding: 14px 34px; border-radius: 50px; text-decoration: none;
            margin-top: 10px; transition: transform 150ms ease, box-shadow 150ms ease;
        }
        .btn-mp:hover { box-shadow: 0 0 24px rgba(139, 92, 246, 0.5); transform: translateY(-1px); }
        .btn-mp:active { transform: scale(0.97); }

        /* Aviso simple, tono neutro, para cuando una pestaña necesita MP conectado. */
        .aviso-info {
            border: 1px solid rgba(34, 211, 238, 0.3); background: rgba(34, 211, 238, 0.08);
            border-radius: 10px; padding: 14px 16px; margin: 10px 0; color: var(--zinc-300); font-size: 0.88rem;
        }
        .aviso-info a { color: var(--accent-2); font-weight: 600; }

        /* Métricas: grid de tarjetas oscuras, borde sutil casi imperceptible salvo al mirar de cerca. */
        .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 20px; }
        @media (max-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
        .card { background: var(--zinc-900); border: 1px solid var(--zinc-800); border-radius: 12px; padding: 16px; text-align: center; }
        .card .numero { font-size: 1.5rem; font-weight: 700; color: var(--text); }
        .card .etiqueta { color: var(--zinc-400); font-size: 0.78rem; margin-top: 4px; }
        /* Bloque de cortesias: 2 cards chicas (no 4, para no competir en ancho con las de
           arriba) + la nota SIEMPRE en su propia línea debajo, nunca compartiendo fila con
           las cards — así el texto tiene todo el ancho del panel para acomodarse y no se
           aprieta ni se corta en pantallas medianas. */
        .bloque-cortesias { margin-top: 12px; }
        .grid-cortesias { grid-template-columns: repeat(2, minmax(0, 220px)); }
        @media (max-width: 480px) { .grid-cortesias { grid-template-columns: repeat(2, 1fr); } }
        .card-cortesia { border-style: dashed; }
        .card-cortesia .numero { color: var(--zinc-300); }
        .nota-cortesias {
            color: var(--zinc-400); font-size: 0.78rem; line-height: 1.5;
            margin: 10px 0 0; max-width: 640px;
        }

        /* Desglose por tipo de entrada: una fila por tipo, con nombre / cantidad / subtotal
           en columnas de ancho fijo para que quede alineado como una mini tabla. */
        .tabla-desglose { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; }
        .fila-desglose {
            display: grid; grid-template-columns: 1fr auto auto; align-items: baseline; gap: 14px;
            padding: 10px 4px; border-bottom: 1px solid var(--zinc-800); font-size: 0.85rem;
        }
        .fila-desglose:last-child { border-bottom: none; }
        .fila-desglose-nombre { color: var(--text); font-weight: 600; }
        .fila-desglose-cant { color: var(--zinc-400); font-size: 0.8rem; white-space: nowrap; }
        .fila-desglose-subtotal { color: var(--accent-2); font-weight: 700; white-space: nowrap; }
        @media (max-width: 480px) {
            .fila-desglose { grid-template-columns: 1fr; gap: 3px; }
        }

        /* Link de venta pública: informativo, tono neutro-acento. */
        .link-box { margin-top: 20px; background: var(--zinc-900); border: 1px solid var(--zinc-800); padding: 15px; border-radius: 12px; font-size: 0.85rem; word-break: break-all; }
        .link-box a { color: var(--accent-2); }
        .link-box strong { display: block; margin-bottom: 4px; color: var(--text); }
        /* Link del guardia: rojo oscuro/translúcido, para que se lea como "manejar con cuidado". */
        .link-box.peligro { background: rgba(248, 113, 113, 0.08); border-color: rgba(248, 113, 113, 0.35); }
        .link-box.peligro a { color: #fca5a5; }
        .link-box .aviso { color: #fca5a5; font-weight: bold; font-size: 0.8rem; display: block; margin-top: 6px; }

        .acciones { display: flex; gap: 10px; margin-top: 20px; }
        .acciones button, .acciones a { flex: 1; padding: 10px; border-radius: 999px; text-align: center; text-decoration: none; cursor: pointer; border: 1px solid var(--zinc-800); font-size: 0.9rem; }
        .btn-editar { background: var(--zinc-900); color: var(--text); }
        .btn-editar:hover { border-color: var(--accent); color: var(--accent-2); }
        .btn-eliminar { background: var(--danger-bg); color: var(--danger); border-color: rgba(248, 113, 113, 0.3); }
        .btn-eliminar:hover { background: rgba(248, 113, 113, 0.16); }

        /* Tabla de ventas: fondo transparente, fila resaltada al pasar el mouse. El contenedor
           es más alto que antes (min-height, no un tope bajo) para que 10 filas entren sin
           cortarse — la paginación (ver JS) se encarga de que nunca haya más de 10 a la vez. */
        table { width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 0.82rem; background: transparent; }
        th { text-align: left; padding: 8px; color: var(--zinc-400); font-weight: 600; border-bottom: 1px solid var(--zinc-800); position: sticky; top: 0; background: var(--bg, #09090b); }
        td { text-align: left; padding: 8px; color: var(--zinc-300); border-bottom: 1px solid var(--zinc-800); }
        tbody tr:hover, table tr:hover td { background: var(--zinc-900); }
        .tabla-ventas-scroll { max-height: 620px; overflow-y: auto; }

        .paginacion-ventas {
            display: flex; align-items: center; justify-content: center; gap: 14px;
            margin-top: 14px; font-size: 0.85rem; color: var(--zinc-400);
        }
        .paginacion-ventas button {
            background: var(--zinc-900); border: 1px solid var(--zinc-800); color: var(--text);
            border-radius: 999px; padding: 7px 16px; cursor: pointer; font-size: 0.82rem; font-weight: 600;
        }
        .paginacion-ventas button:disabled { opacity: 0.4; cursor: default; }
        .paginacion-ventas button:not(:disabled):hover { border-color: var(--accent); color: var(--accent-2); }

        .nota { text-align: center; color: var(--text-faint); font-size: 0.8rem; margin-top: 20px; }

        /* Módulos de acción (cortesía / reenvío / export): misma tarjeta oscura que las métricas. */
        .panel-op { background: var(--zinc-900); border: 1px solid var(--zinc-800); border-radius: 12px; padding: 18px; margin-top: 20px; }
        .panel-op h3 { margin-top: 0; color: var(--text); }
        .panel-op .fila { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
        .panel-op input {
            flex: 1; min-width: 120px; background: var(--zinc-900); color: var(--text);
            border: 1px solid var(--zinc-800); border-radius: 999px; padding: 9px 16px;
        }
        .panel-op button {
            padding: 9px 18px; border: none; border-radius: 999px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: white; cursor: pointer; font-weight: 600;
        }
        .panel-op button:active { transform: scale(0.97); }

        /* Tarjeta del gráfico de Chart.js: mismo fondo zinc-900 de las demás, pero con una
           sombra suave propia (las otras tarjetas del panel solo llevan borde). */
        .grafico-card { box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.6); }
        .grafico-lienzo { position: relative; height: 220px; margin-top: 10px; }
        .btn-export {
            display: inline-block; margin-top: 8px; padding: 9px 18px; border-radius: 999px;
            background: transparent; color: var(--accent-2); text-decoration: none; font-size: 0.85rem;
            border: 1px solid var(--zinc-800);
        }
        .btn-export:hover { border-color: var(--accent-2); background: rgba(34, 211, 238, 0.08); }

        /* Aviso de SPAM: tonos mostaza/amarillo oscuro (no rojo — no es un error, es una guía). */
        .aviso-spam {
            border: 1px solid rgba(217, 164, 6, 0.4); background: rgba(133, 100, 4, 0.18);
            border-radius: 10px; padding: 12px 14px; margin-top: 12px; font-size: 0.82rem;
            color: #facc15; font-weight: 600;
        }

        .aviso-solo-lectura {
            border: 1px solid rgba(161, 161, 170, 0.3); background: rgba(161, 161, 170, 0.08);
            border-radius: 10px; padding: 12px 15px; margin: 15px 0;
            color: var(--zinc-300); font-size: 0.85rem;
        }

        /* Tarjetas de guardias de la app móvil. */
        .lista-guardias { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
        .guardia-card {
            background: var(--zinc-800); border-radius: 10px; padding: 12px 14px; font-size: 0.85rem;
        }
        .guardia-card.inactivo { opacity: 0.55; }
        .guardia-editar .fila { margin-top: 0; }
        .guardia-pie { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
        .guardia-pie .guardia-acciones { margin-left: auto; }

        /* Campo de contraseña con el botón de ojo adentro, a la derecha. */
        .campo-password { position: relative; flex: 1; min-width: 150px; display: flex; }
        .campo-password input { flex: 1; padding-right: 42px; }
        .campo-password .ojo {
            position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
            background: none; border: none; padding: 4px 8px; cursor: pointer;
            font-size: 1rem; line-height: 1; opacity: 0.6;
        }
        .campo-password .ojo:hover { opacity: 1; }
        .campo-password .ojo.visible { opacity: 1; }
        .badge-fila {
            display: inline-block; margin-left: 8px; background: rgba(139, 92, 246, 0.15);
            color: var(--accent-2); border: 1px solid rgba(139, 92, 246, 0.3);
            border-radius: 999px; padding: 2px 9px; font-size: 0.72rem; font-weight: 600;
        }
        .guardia-acciones { display: flex; gap: 6px; flex-shrink: 0; }
        .guardia-acciones form { margin: 0; }
        .guardia-acciones button {
            border: 1px solid var(--zinc-800); background: var(--zinc-900); color: var(--text);
            border-radius: 999px; padding: 5px 12px; font-size: 0.75rem; cursor: pointer;
        }
        .guardia-acciones button.eliminar { color: #fca5a5; }
        .guardia-acciones button.eliminar:hover { background: rgba(248, 113, 113, 0.12); border-color: rgba(248, 113, 113, 0.35); }

        /* Tarjeta bien visible de la app de guardias — mismo look que .conectar-box (borde
           violeta brillante), para que salte a la vista igual que la de Mercado Pago. */
        .app-guardias-card {
            background: var(--zinc-900); border-radius: 14px; padding: 22px; margin: 20px 0;
            box-shadow: 0 0 0 1px rgba(139, 92, 246, 0.4), 0 0 24px rgba(139, 92, 246, 0.18);
        }
        .app-guardias-header { display: flex; gap: 14px; align-items: flex-start; }
        .app-guardias-icono { font-size: 1.8rem; line-height: 1; }
        .app-guardias-header strong { color: white; font-size: 1.05rem; }
        .app-guardias-header p { color: var(--zinc-400); font-size: 0.85rem; margin: 4px 0 0; }
        .app-guardias-acciones { display: flex; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
        .app-guardias-acciones .btn { width: auto; }
        .app-guardias-copiado { display: block; margin-top: 10px; color: #34d399; font-size: 0.82rem; font-weight: 600; }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="contenedor">
    <a class="volver" href="/mis-eventos">&larr; Volver a Mis Eventos</a>
    <div class="encabezado-evento">
        <h1><%= evento.nombre %></h1>
        <p class="subtitulo"><%= formatearFecha(evento.fecha) %></p>
    </div>

    <% if (soloLectura) { %>
        <div class="aviso-solo-lectura">
            🏁 Este evento está <strong>finalizado</strong>: quedó en modo solo lectura. Podés
            consultar estadísticas, ventas e historial, pero ya no se puede editar ni emitir
            entradas nuevas.
        </div>
    <% } %>

    <% if (conectado) { %>
        <div class="aviso-ok">✅ ¡Tu Mercado Pago quedó conectado! Ya podés compartir el link de venta.</div>
    <% } %>
    <% if (typeof cortesia !== 'undefined' && cortesia) { %>
        <div class="aviso-ok">🎟️ Entradas de cortesía generadas y enviadas por mail.</div>
    <% } %>
    <% if (typeof reenviado !== 'undefined' && reenviado) { %>
        <div class="aviso-ok">📩 Entradas reenviadas correctamente.</div>
    <% } %>
    <% if (typeof filasAsignadas !== 'undefined' && filasAsignadas) { %>
        <div class="aviso-ok">🚧 Entradas repartidas al azar en <%= filasAsignadas %> fila<%= filasAsignadas == 1 ? '' : 's' %>.</div>
    <% } %>
    <% if (typeof errorGuardia !== 'undefined' && errorGuardia) { %>
        <div class="alerta-error" style="margin-bottom:15px;"><%= errorGuardia %></div>
    <% } %>

    <!-- Pestañas: reemplazan el scroll infinito de antes. El tab activo se guarda en el hash
         de la URL (#estadisticas, #guardias) para que sobreviva a un F5 o al botón Actualizar
         (que hace location.reload() — la URL con su hash no cambia). -->
    <div class="tabs-nav" role="tablist">
        <button type="button" class="tab-btn activo" data-tab="principal" role="tab">Principal</button>
        <button type="button" class="tab-btn" data-tab="estadisticas" role="tab">Estadísticas</button>
        <button type="button" class="tab-btn" data-tab="guardias" role="tab">Guardias y Accesos</button>
    </div>

    <!-- ===================== PESTAÑA 1: PRINCIPAL ===================== -->
    <section class="tab-panel" id="tab-principal" role="tabpanel">
        <% if (!evento.conectado_mp) { %>
            <div class="conectar-box">
                <span class="badge-recomendado">Recomendado</span>
                <h2>Conectá tu Mercado Pago</h2>
                <p>Falta un solo paso para poder vender: conectá tu cuenta para que el dinero de cada venta te llegue directo a vos.</p>
                <ul class="beneficios-mp">
                    <li>Pagos al instante</li>
                    <li>Pagos seguros, sin intermediarios</li>
                    <li>El dinero llega directo a tu cuenta</li>
                    <li>Sin cargo extra por usar la plataforma</li>
                </ul>
                <a class="btn-mp" href="<%= urlConexionMP %>">Conectar con Mercado Pago</a>
            </div>
        <% } else { %>
            <div class="link-box">
                <strong>Link para vender tus entradas:</strong>
                <a href="<%= urlPublica %>" target="_blank"><%= urlPublica %></a>
            </div>
        <% } %>

        <div class="acciones">
            <% if (!soloLectura) { %>
                <a class="btn-editar" href="/eventos/<%= evento.id %>/editar">Editar evento</a>
                <form action="/eventos/<%= evento.id %>/finalizar" method="POST" style="flex:1;"
                      onsubmit="return confirm('¿Marcar el evento como finalizado? Va a quedar en modo solo lectura: vas a poder ver estadísticas e historial, pero no editarlo.');">
                    <input type="hidden" name="finalizar" value="1">
                    <button class="btn-editar" type="submit" style="width:100%;">Marcar como finalizado</button>
                </form>
            <% } else if (evento.finalizado) { %>
                <form action="/eventos/<%= evento.id %>/finalizar" method="POST" style="flex:1;">
                    <input type="hidden" name="finalizar" value="0">
                    <button class="btn-editar" type="submit" style="width:100%;">Reabrir evento</button>
                </form>
            <% } %>
            <% if (!soloLectura || esAdmin) { %>
                <form action="/eventos/<%= evento.id %>/eliminar" method="POST" style="flex:1;"
                      onsubmit="return confirm('¿Estás SEGURO que querés eliminar este evento? Se van a borrar también todas sus entradas vendidas. Esta acción no se puede deshacer.');">
                    <button class="btn-eliminar" type="submit" style="width:100%;">Eliminar evento</button>
                </form>
            <% } %>
        </div>

        <% if (!soloLectura) { %>
        <div class="panel-op">
            <h3>🎟️ Entradas de cortesía</h3>
            <p style="font-size:0.82rem; color:var(--zinc-400); margin:0;">
                Genera QRs válidos sin cobrar (invitados, prensa, staff) y los manda por mail al toque.
                Descuentan el cupo del tipo de entrada que elijas, igual que una venta.
            </p>
            <% if (tipos.length === 0) { %>
                <p style="color:var(--zinc-400); font-size:0.85rem; margin-top:10px;">Primero creá al menos un tipo de entrada desde "Editar evento".</p>
            <% } else { %>
                <form action="/eventos/<%= evento.id %>/cortesia" method="POST" class="fila">
                    <input type="text" name="nombre_apellido" placeholder="Nombre y apellido" required>
                    <input type="email" name="email" placeholder="Email del invitado" required>
                    <select name="tipo_entrada_id" required style="flex:1; min-width:140px;">
                        <% tipos.forEach(t => { %>
                            <option value="<%= t.id %>"><%= t.nombre %> (quedan <%= t.cupo_disponible %>)</option>
                        <% }) %>
                    </select>
                    <input type="number" name="cantidad" placeholder="Cant." min="1" max="20" value="1" required style="max-width:80px;">
                    <button type="submit">Generar y enviar</button>
                </form>
            <% } %>
        </div>
        <% } %>

        <div class="panel-op">
            <h3>📩 Reenviar QR</h3>
            <p style="font-size:0.82rem; color:var(--zinc-400); margin:0;">Reenvía TODAS las entradas de ese email para este evento (no genera entradas nuevas).</p>
            <form action="/eventos/<%= evento.id %>/reenviar-qr" method="POST" class="fila">
                <input type="email" name="email" placeholder="Email del comprador" required>
                <button type="submit">Reenviar</button>
            </form>
            <div class="aviso-spam">
                ⚠️ Si el asistente dice que "no le llegó" el mail con la entrada, primero pedile que revise
                la carpeta de <strong>SPAM / Correo no deseado</strong> antes de reenviar — la mayoría de los
                casos están ahí.
            </div>
        </div>
    </section>

    <!-- ===================== PESTAÑA 2: ESTADÍSTICAS ===================== -->
    <section class="tab-panel" id="tab-estadisticas" role="tabpanel" hidden>
        <!-- Antes el panel se refrescaba solo cada 30s (meta refresh) y los gráficos cada
             20-30s (setInterval), consumiendo el server sin que nadie estuviera mirando.
             Ahora todo se actualiza SOLO cuando el organizador lo pide con este botón. -->
        <button type="button" id="btn-actualizar-panel" class="btn-actualizar" onclick="actualizarPanel(this)">
            🔄 Actualizar
        </button>

        <% if (!evento.conectado_mp) { %>
            <div class="aviso-info">
                📊 Todavía no hay estadísticas: conectá tu Mercado Pago desde la pestaña
                <strong>Principal</strong> para empezar a vender y ver los números acá.
            </div>
        <% } else { %>
            <div class="grid">
                <div class="card"><div class="numero"><%= resumen.total_vendidas || 0 %></div><div class="etiqueta">Vendidas</div></div>
                <div class="card"><div class="numero"><%= resumen.total_ingresadas || 0 %></div><div class="etiqueta">Ingresaron</div></div>
                <div class="card"><div class="numero"><%= resumen.total_compradores || 0 %></div><div class="etiqueta">Compradores</div></div>
                <div class="card"><div class="numero">$<%= recaudacion.toLocaleString('es-AR') %></div><div class="etiqueta">Recaudación</div></div>
            </div>

            <!-- Bloque aparte a propósito: las cortesías ocupan cupo y entran por la puerta, pero
                 NO son plata. Vive fuera del grid de arriba y con otro estilo, para que no se
                 confunda con las entradas vendidas ni sume a la recaudación. La nota va SIEMPRE
                 debajo, en su propia línea de ancho completo — no comparte fila con las cards,
                 así el texto nunca queda apretado contra ellas ni se corta en pantallas medianas. -->
            <div class="bloque-cortesias">
                <div class="grid grid-cortesias">
                    <div class="card card-cortesia">
                        <div class="numero"><%= resumen.total_cortesias || 0 %></div>
                        <div class="etiqueta">Cortesías entregadas</div>
                    </div>
                    <div class="card card-cortesia">
                        <div class="numero"><%= (resumen.total_entradas || 0) %></div>
                        <div class="etiqueta">Entradas emitidas (vendidas + cortesías)</div>
                    </div>
                </div>
                <p class="nota-cortesias">
                    Las cortesías <strong>no suman</strong> a la recaudación ni a las ganancias:
                    descuentan cupo del tipo de entrada elegido, pero se emiten sin cobro.
                </p>
            </div>

            <!-- Desglose por tipo de entrada: cuántas se vendieron de cada categoría y cuánto
                 recaudó cada una, usando el mismo precio histórico que la recaudación total. -->
            <% if (desglosePorTipo && desglosePorTipo.length > 0) { %>
            <div class="panel-op">
                <h3>🎟️ Desglose por tipo de entrada</h3>
                <div class="tabla-desglose">
                    <% desglosePorTipo.forEach((t) => { %>
                        <div class="fila-desglose">
                            <span class="fila-desglose-nombre"><%= t.tipoNombre %></span>
                            <span class="fila-desglose-cant">
                                <%= t.vendidas %> vendida<%= t.vendidas === 1 ? '' : 's' %><%
                                if (t.cortesias > 0) { %> + <%= t.cortesias %> cortesía<%= t.cortesias === 1 ? '' : 's' %><% } %>
                            </span>
                            <span class="fila-desglose-subtotal">$<%= t.subtotal.toLocaleString('es-AR') %></span>
                        </div>
                    <% }) %>
                </div>
            </div>
            <% } %>

            <div class="panel-op grafico-card">
                <h3>📊 Ventas en el tiempo</h3>
                <div class="grafico-lienzo">
                    <canvas id="graficoVentas"></canvas>
                </div>
            </div>

            <div class="panel-op">
                <h3>📋 Exportación de contingencia</h3>
                <p style="font-size:0.82rem; color:var(--zinc-400); margin:0;">Descargá la lista completa de asistentes (CSV, se abre directo en Excel) para tener offline en la puerta.</p>
                <a class="btn-export" href="/eventos/<%= evento.id %>/exportar-csv">⬇ Descargar CSV</a>
            </div>

            <% if (ventas.length > 0) { %>
                <h3 style="margin-top: 30px;">Ventas realizadas</h3>
                <div class="table-scroll tabla-ventas-scroll">
                <table id="tabla-ventas">
                    <thead>
                        <tr>
                            <th>ID cliente</th>
                            <th>Nombre y apellido</th>
                            <th>Email</th>
                            <th>Tipo</th>
                            <th>ID entrada</th>
                            <th>Estado</th>
                            <th>Fecha compra</th>
                            <th>Fecha escaneada</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-ventas-cuerpo">
                        <% ventas.forEach(v => { %>
                            <tr>
                                <td><%= v.id_cliente || '-' %></td>
                                <td><%= v.nom_y_apellido || '-' %></td>
                                <td><%= v.email || '-' %></td>
                                <td><%= v.tipo_entrada || (v.origen === 'cortesia' ? 'Cortesía' : '-') %></td>
                                <td><%= v.id_entrada %></td>
                                <td><%= v.estado_entrada %></td>
                                <td><%= formatearFechaHora(v.fecha_y_hora_compra) %></td>
                                <td><%= formatearFechaHora(v.fecha_y_hora_escaneada) %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
                </div>
                <div class="paginacion-ventas" id="paginacion-ventas">
                    <button type="button" id="btn-pagina-anterior">&larr; Anterior</button>
                    <span id="texto-pagina-ventas">Página 1</span>
                    <button type="button" id="btn-pagina-siguiente">Siguiente &rarr;</button>
                </div>
            <% } %>
        <% } %>
    </section>

    <!-- ===================== PESTAÑA 3: GUARDIAS Y ACCESOS ===================== -->
    <section class="tab-panel" id="tab-guardias" role="tabpanel" hidden>
        <% if (soloLectura) { %>
            <div class="aviso-solo-lectura">
                🏁 Este evento está finalizado: la gestión de guardias y accesos quedó deshabilitada.
            </div>
        <% } else { %>
            <div class="link-box peligro">
                <strong>🔒 Link privado para el guardia de seguridad:</strong>
                <a href="<%= urlGuardia %>" target="_blank"><%= urlGuardia %></a>
                <span class="aviso">No lo compartas con nadie que no sea personal de seguridad de ESTE evento. Cualquiera que lo abra puede validar entradas.</span>
            </div>

            <div class="app-guardias-card">
                <div class="app-guardias-header">
                    <span class="app-guardias-icono">📱</span>
                    <div>
                        <strong>App para Guardias</strong>
                        <p>La instalan una sola vez en el celular de cada guardia y después inician sesión con el email/contraseña que les creaste abajo.</p>
                    </div>
                </div>
                <div class="app-guardias-acciones">
                    <a class="btn btn-primary" href="<%= URL_APK_GUARDIAS %>" target="_blank" rel="noopener noreferrer">⬇ Descargar APK</a>
                    <button type="button" class="btn btn-ghost" id="btnCopiarLinkApk">Copiar link</button>
                </div>
                <span id="avisoCopiado" class="app-guardias-copiado" hidden>✅ Link copiado — pegalo en WhatsApp.</span>
            </div>

            <div class="panel-op">
                <h3>🚧 Cierre de evento — Reparto por fila</h3>
                <p style="font-size:0.82rem; color:var(--zinc-400); margin:0;">
                    Define cuántas filas/guardias va a tener la puerta y reparte TODAS las entradas
                    vendidas entre ellas, al azar y en partes iguales (mezclando tipos de entrada).
                    Usalo el día del evento, una vez que ya sabés cuántas puertas vas a tener.
                </p>
                <form action="/eventos/<%= evento.id %>/asignar-filas" method="POST" class="fila"
                      onsubmit="return confirm('¿Repartir todas las entradas vendidas entre las filas indicadas? Si ya habías repartido antes, esto lo vuelve a mezclar de cero.');">
                    <input type="number" name="cantidad_filas" placeholder="Cant. de filas/guardias" min="1" max="20" value="1" required>
                    <button type="submit">Repartir entradas</button>
                </form>
            </div>

            <div class="panel-op">
                <h3>👮 Guardias (app móvil)</h3>
                <p style="font-size:0.82rem; color:var(--zinc-400); margin:0;">
                    Creá una cuenta por guardia (email + contraseña) para que inicien sesión desde la
                    app móvil de seguridad — cada uno ve solo el número de fila que le asignes acá.
                </p>
                <form action="/eventos/<%= evento.id %>/guardias" method="POST" class="fila">
                    <input type="email" name="email" placeholder="Email del guardia" required>
                    <div class="campo-password">
                        <input type="password" name="password" placeholder="Contraseña (min. 8)" minlength="8" required>
                        <button type="button" class="ojo" aria-label="Mostrar u ocultar la contraseña">👁</button>
                    </div>
                    <input type="number" name="fila_asignada" placeholder="Fila" min="1" max="20" required style="max-width:80px;">
                    <button type="submit">+ Crear guardia</button>
                </form>

                <% if (guardias.length === 0) { %>
                    <p style="color:var(--text-faint); font-size:0.85rem; margin-top:10px;">Todavía no creaste ningún guardia para este evento.</p>
                <% } else { %>
                    <div class="lista-guardias">
                        <% guardias.forEach(g => { %>
                            <div class="guardia-card <%= g.activo ? '' : 'inactivo' %>">
                                <form action="/eventos/<%= evento.id %>/guardias/<%= g.id %>/editar" method="POST" class="guardia-editar">
                                    <div class="fila">
                                        <input type="email" name="email" value="<%= g.email %>" required>
                                        <div class="campo-password">
                                            <input type="password" name="password" placeholder="Dejar vacío = no cambiar" minlength="8">
                                            <button type="button" class="ojo" aria-label="Mostrar u ocultar la contraseña">👁</button>
                                        </div>
                                        <input type="number" name="fila_asignada" value="<%= g.fila_asignada %>" min="1" max="20" required style="max-width:80px;">
                                        <button type="submit">Guardar</button>
                                    </div>
                                </form>
                                <div class="guardia-pie">
                                    <span class="badge-fila">Fila <%= g.fila_asignada %></span>
                                    <span style="color:var(--zinc-400); font-size:0.78rem;"><%= g.activo ? 'Activo' : 'Desactivado' %></span>
                                    <div class="guardia-acciones">
                                        <form action="/eventos/<%= evento.id %>/guardias/<%= g.id %>/toggle" method="POST">
                                            <button type="submit"><%= g.activo ? 'Desactivar' : 'Activar' %></button>
                                        </form>
                                        <form action="/eventos/<%= evento.id %>/guardias/<%= g.id %>/eliminar" method="POST"
                                              onsubmit="return confirm('¿Borrar al guardia <%= g.email %>?');">
                                            <button type="submit" class="eliminar">Borrar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        <% } %>
    </section>

    </div>

    <script>
        // Gráfico de líneas de ventas en el tiempo, con Chart.js. Paleta pensada para calzar
        // con el Dark Mode Premium del resto del panel: línea en el color de acento, ejes y
        // textos en gris tenue, sin grilla invasiva (solo una línea horizontal muy sutil).
        (function () {
            const canvas = document.getElementById('graficoVentas');
            if (!canvas || typeof Chart === 'undefined') return; // evento sin MP conectado, o el CDN no cargó

            const ESTILOS = getComputedStyle(document.documentElement);
            const COLOR_ACENTO = ESTILOS.getPropertyValue('--accent').trim() || '#8b5cf6';
            const COLOR_ACENTO_2 = ESTILOS.getPropertyValue('--accent-2').trim() || '#22d3ee';
            const COLOR_TEXTO_TENUE = '#a1a1aa'; // text-zinc-400
            const COLOR_GRILLA = 'rgba(161, 161, 170, 0.08)'; // casi invisible, solo una guía leve

            let grafico = null;

            async function cargar() {
                try {
                    const resp = await fetch('/api/eventos/<%= evento.id %>/grafico-ventas');
                    const { datos } = await resp.json();

                    const etiquetas = (datos || []).map((d) =>
                        new Date(d.fecha).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit' })
                    );
                    const valores = (datos || []).map((d) => Number(d.entradas_vendidas));

                    if (grafico) grafico.destroy();
                    grafico = new Chart(canvas.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: etiquetas,
                            datasets: [{
                                label: 'Entradas vendidas',
                                data: valores,
                                borderColor: COLOR_ACENTO,
                                backgroundColor: (ctx) => {
                                    // Relleno degradado sutil bajo la línea, en vez de un bloque sólido.
                                    const { chartArea, ctx: c } = ctx.chart;
                                    if (!chartArea) return 'transparent';
                                    const gradiente = c.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                                    gradiente.addColorStop(0, 'rgba(139, 92, 246, 0.25)');
                                    gradiente.addColorStop(1, 'rgba(139, 92, 246, 0)');
                                    return gradiente;
                                },
                                fill: true,
                                tension: 0.35, // línea curva y fluida, no quebrada
                                borderWidth: 2,
                                pointRadius: 3,
                                pointBackgroundColor: COLOR_ACENTO_2,
                                pointBorderColor: COLOR_ACENTO_2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false }, // un solo dataset: la leyenda no aporta nada
                                tooltip: {
                                    backgroundColor: '#18181b',
                                    borderColor: '#27272a',
                                    borderWidth: 1,
                                    titleColor: '#f4f4f5',
                                    bodyColor: COLOR_TEXTO_TENUE,
                                    padding: 10,
                                    displayColors: false
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false }, // sin grilla vertical: se ve mucho más limpio
                                    ticks: { color: COLOR_TEXTO_TENUE, font: { size: 11 } }
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: COLOR_GRILLA, drawTicks: false },
                                    border: { display: false },
                                    ticks: { color: COLOR_TEXTO_TENUE, font: { size: 11 }, precision: 0 }
                                }
                            }
                        }
                    });
                } catch (error) {
                    console.error('Error al cargar el gráfico de ventas:', error);
                }
            }

            cargar();
        })();
    </script>

    <script>
        // Botón de "ojo" para ver/ocultar la contraseña de los guardias. Se resuelve por
        // delegación en el document: los campos son varios (el de alta más uno por guardia) y
        // así funciona para todos sin tener que enganchar un listener a cada uno.
        document.addEventListener('click', (evento) => {
            const boton = evento.target.closest('.campo-password .ojo');
            if (!boton) return;

            const input = boton.parentElement.querySelector('input');
            const mostrando = input.type === 'text';
            input.type = mostrando ? 'password' : 'text';
            boton.classList.toggle('visible', !mostrando);
            boton.textContent = mostrando ? '👁' : '🙈';
        });
    </script>

    <script>
        // Botón "Copiar link" del APK, para que el organizador se lo pase a sus guardias por
        // WhatsApp sin tener que escribir la URL a mano.
        (function () {
            const boton = document.getElementById('btnCopiarLinkApk');
            if (!boton) return;

            boton.addEventListener('click', async () => {
                const url = <%- JSON.stringify(URL_APK_GUARDIAS) %>;
                const aviso = document.getElementById('avisoCopiado');
                try {
                    await navigator.clipboard.writeText(url);
                } catch (error) {
                    // Fallback para navegadores/contextos sin permiso de clipboard.
                    const input = document.createElement('input');
                    input.value = url;
                    document.body.appendChild(input);
                    input.select();
                    document.execCommand('copy');
                    document.body.removeChild(input);
                }
                aviso.hidden = false;
                setTimeout(() => { aviso.hidden = true; }, 3000);
            });
        })();
    </script>

    <script>
        // Reemplaza el polling automático (meta refresh + setInterval de los gráficos, que
        // pegaban al server cada 20-30s aunque nadie estuviera mirando la pantalla). Recarga
        // TODA la página a pedido: así números, tabla de ventas, guardias y ambos gráficos
        // quedan al día en un solo click, sin mantener nada corriendo en segundo plano. El
        // hash de la pestaña activa viaja en la URL, así que sobrevive al reload.
        function actualizarPanel(boton) {
            boton.disabled = true;
            boton.classList.add('girando');
            location.reload();
        }
    </script>

    <script>
        // Pestañas: un único tab visible a la vez. El activo queda en el hash de la URL
        // (#estadisticas, #guardias) para que un reload (F5 o el botón Actualizar) vuelva a
        // la misma pestaña en vez de resetear siempre a "Principal", y para que las acciones
        // del servidor (crear guardia, repartir filas, etc.) puedan redirigir directo a la
        // pestaña correspondiente agregando el hash en la URL de redirect.
        (function () {
            const botones = document.querySelectorAll('.tab-btn');
            const paneles = {
                principal: document.getElementById('tab-principal'),
                estadisticas: document.getElementById('tab-estadisticas'),
                guardias: document.getElementById('tab-guardias')
            };

            function activar(nombre) {
                if (!paneles[nombre]) nombre = 'principal';
                botones.forEach((b) => b.classList.toggle('activo', b.dataset.tab === nombre));
                Object.entries(paneles).forEach(([clave, panel]) => { panel.hidden = clave !== nombre; });
            }

            botones.forEach((boton) => {
                boton.addEventListener('click', () => {
                    const nombre = boton.dataset.tab;
                    history.replaceState(null, '', `#${nombre}`);
                    activar(nombre);
                });
            });

            // Si la URL trae hash (#guardias, #estadisticas) manda eso — pasa en un reload o
            // en un redirect del server tras una acción de esa pestaña. Si no hay hash pero el
            // server pidió abrir una pestaña puntual (ej: reapareció con un error de guardias
            // después de un re-render, sin redirect de por medio), se usa tabInicial.
            const tabInicial = <%- JSON.stringify(typeof tabInicial !== 'undefined' ? tabInicial : null) %>;
            activar((location.hash ? location.hash.slice(1) : (tabInicial || 'principal')));
        })();
    </script>

    <script>
        // Paginación de la tabla de ventas: máximo 10 filas visibles a la vez (las demás
        // quedan en el DOM pero ocultas con `hidden`, no se vuelven a pedir al server).
        (function () {
            const cuerpo = document.getElementById('tabla-ventas-cuerpo');
            if (!cuerpo) return; // sin ventas, no hay tabla que paginar

            const FILAS_POR_PAGINA = 10;
            const filas = Array.from(cuerpo.querySelectorAll('tr'));
            const totalPaginas = Math.max(1, Math.ceil(filas.length / FILAS_POR_PAGINA));
            let paginaActual = 1;

            const textoPagina = document.getElementById('texto-pagina-ventas');
            const btnAnterior = document.getElementById('btn-pagina-anterior');
            const btnSiguiente = document.getElementById('btn-pagina-siguiente');
            const paginacion = document.getElementById('paginacion-ventas');

            // Con una sola página no tiene sentido mostrar los controles de avanzar/retroceder.
            if (totalPaginas <= 1) { paginacion.style.display = 'none'; }

            function mostrarPagina(pagina) {
                paginaActual = pagina;
                const desde = (pagina - 1) * FILAS_POR_PAGINA;
                const hasta = desde + FILAS_POR_PAGINA;
                filas.forEach((fila, i) => { fila.hidden = i < desde || i >= hasta; });
                textoPagina.textContent = `Página ${pagina} de ${totalPaginas}`;
                btnAnterior.disabled = pagina <= 1;
                btnSiguiente.disabled = pagina >= totalPaginas;
            }

            btnAnterior.addEventListener('click', () => { if (paginaActual > 1) mostrarPagina(paginaActual - 1); });
            btnSiguiente.addEventListener('click', () => { if (paginaActual < totalPaginas) mostrarPagina(paginaActual + 1); });

            mostrarPagina(1);
        })();
    </script>
</body>
</html>
