# Copiá este archivo como ".env" y completá con tus datos reales.
# NUNCA subas el archivo ".env" a un repositorio (ya está en .gitignore).

# Access Token de Mercado Pago (Dashboard de Mercado Pago > Tus integraciones > Credenciales)
MP_ACCESS_TOKEN=

# Gmail desde el que se envían las entradas por correo
GMAIL_USER=
# Contraseña de aplicación de 16 letras (Google Account > Seguridad > Contraseñas de aplicaciones)
# NO es la contraseña normal de tu cuenta de Gmail
GMAIL_APP_PASSWORD=

# Clave que usa el celular del guardia para activarse (ej: /login-guardia?clave=TU_CLAVE)
GUARDIA_CLAVE=

# Clave para entrar al panel de admin (crear/ocultar eventos): /admin/eventos?clave=TU_CLAVE
ADMIN_CLAVE=

# URL pública donde va a vivir la app (sin barra al final), ej: https://tuapp.up.railway.app
BASE_URL=

# Puerto (Railway/Render lo asignan solos; dejalo vacío en producción)
PORT=3000

# Cadena de conexión a MySQL. En Railway: agregá el plugin "MySQL" al proyecto y
# referenciá la variable MYSQL_URL de ese servicio (no hace falta armarla a mano).
# En local, si corrés un MySQL propio: mysql://usuario:password@localhost:3306/nombre_db
MYSQL_URL=

# Notificaciones de ventas e ingresos por Telegram (opcional).
# Token del bot: te lo da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# Chat ID: el ID numérico del chat/grupo donde se envían los avisos (ej: obtenido con @userinfobot)
TELEGRAM_CHAT_ID=
