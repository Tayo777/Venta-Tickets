# Copiá este archivo como ".env" y completá con tus datos reales.
# NUNCA subas el archivo ".env" a un repositorio (ya está en .gitignore).

# Access Token de Mercado Pago (Dashboard de Mercado Pago > Tus integraciones > Credenciales)
MP_ACCESS_TOKEN=

# Gmail desde el que se envían las entradas por correo
GMAIL_USER=
# Contraseña de aplicación de 16 letras (Google Account > Seguridad > Contraseñas de aplicaciones)
# NO es la contraseña normal de tu cuenta de Gmail
GMAIL_APP_PASSWORD=

# Clave que usa el celular del guardia para activarse (ej: /login-guardia?clave=TU_CLAVE)
GUARDIA_CLAVE=

# URL pública donde va a vivir la app (sin barra al final), ej: https://tuapp.up.railway.app
BASE_URL=

# Puerto (Railway/Render lo asignan solos; dejalo vacío en producción)
PORT=3000

# Ruta del archivo SQLite. En local podés dejarlo vacío (usa ./entradas.db).
# En Railway, apuntalo a la carpeta del Volume, ej: /data/entradas.db
DB_PATH=
