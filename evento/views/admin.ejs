<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 900px; margin: 40px auto; padding: 20px; }
        .top-nav { display: flex; justify-content: space-between; align-items: center; }
        .top-nav form button { background: none; border: none; color: #636e72; text-decoration: underline; cursor: pointer; }
        h1 { margin-bottom: 5px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { text-align: left; padding: 8px; border-bottom: 1px solid #eee; font-size: 13px; }
        .badge { padding: 3px 8px; border-radius: 10px; font-size: 12px; color: white; }
        .activo { background: #27ae60; }
        .sin-conectar { background: #e67e22; }
        .btn-aprobar { background: #27ae60; color: white; border: none; padding: 6px 12px; border-radius: 5px; cursor: pointer; text-decoration: none; font-size: 12px; }
    </style>
</head>
<body>
    <div class="top-nav">
        <h1>Panel de administración</h1>
        <form action="/logout" method="POST"><button type="submit">Cerrar sesión</button></form>
    </div>

    <h3>Usuarios esperando aprobación</h3>
    <% if (pendientes.length === 0) { %>
        <p style="color:#b2bec3;">No hay solicitudes pendientes.</p>
    <% } else { %>
        <table>
            <tr><th>Nombre</th><th>Mail</th><th>Teléfono</th><th></th></tr>
            <% pendientes.forEach(u => { %>
                <tr>
                    <td><%= u.nombre %></td>
                    <td><%= u.email %></td>
                    <td><%= u.telefono %></td>
                    <td><a class="btn-aprobar" href="/admin/aprobar/<%= u.id %>?token=<%= u.token_aprobacion %>">Aprobar</a></td>
                </tr>
            <% }) %>
        </table>
    <% } %>

    <h3 style="margin-top: 30px;">Todos los eventos</h3>
    <table>
        <tr><th>Nombre</th><th>Dueño</th><th>Mercado Pago</th><th></th></tr>
        <% eventos.forEach(evento => { %>
            <tr>
                <td><%= evento.nombre %></td>
                <td><%= evento.dueño_email || '-' %></td>
                <td><span class="badge <%= evento.conectado_mp ? 'activo' : 'sin-conectar' %>"><%= evento.conectado_mp ? 'Conectado' : 'Sin conectar' %></span></td>
                <td><a href="/eventos/<%= evento.id %>">Ver panel</a></td>
            </tr>
        <% }) %>
    </table>
</body>
</html>
